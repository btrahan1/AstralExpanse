@page "/"
@using AstralExpanse.Services
@using AstralExpanse.Components
@inject BabylonService BabylonService
@inject GameStateService GameState
@inject PersistenceService Persistence
@inject IJSRuntime JSRuntime
@inject HttpClient Http
@inject MissionService Missions
@inject ConstructionService Construction
@inject ColonyService Colony
@inject FarmingService Farming
@inject RoverService RoverService
@inject CombatService Combat
@implements IDisposable

<PageTitle>Astral Expanse</PageTitle>

<Viewport />

@if (!_isGameActive)
{
    <MainMenu OnNewGame="HandleNewGame" OnContinueGame="HandleContinueGame" />
}

@if (_isGameActive)
{
    @if (_showShipyard)
    {
        <ShipyardMenu Show="_showShipyard" OnClose="() => _showShipyard = false" OnBuildShip="BuildNewShip" />
    }

    <MiningMenu Show="_showMiningMenu" X="_mouseX" Y="_mouseY" OnStartMining="StartMiningMission" />

    <FleetPanel 
        SelectedShipId="@_selectedShipId" 
        SelectedStationId="@_selectedStationId"
        OnSelectShip="HandleSelectShipFromPanel" 
        OnSelectStation="HandleSelectStation"
        OnVisitPlanet="VisitColony" 
        OnStopMining="HandleStopMining" 
        OnStartMission="HandleStartMission" 
        OnInitiateTow="id => _isTowingMode = true" 
        OnOpenShipyard="id => { _shipyardStationId = id; _showShipyard = true; }"
        OnInitiateStationTow="HandleInitiateStationTow"
        Visible="@(!_isSurfaceView)" />
    
    @if (_isSurfaceView)
    {
        <SurfaceOverlay OnReturn="ExitSurfaceView" />
        <ColonyMenu Show="_showColonyMenu" PlanetId="@_currentSurfacePlanetId" OnClose="() => _showColonyMenu = false" />
        <RoverUI />
    }


    <Radar @ref="_radar" Visible="true" IsPlanetaryView="@_isSurfaceView" OnLocationSelected="HandleRadarLocationSelected" />

    <div class="ui-container" tabindex="-1" @onkeydown="HandleKeyDown" @onkeyup="HandleKeyUp">
        <div class="ui-overlay">
            @if (!_isSurfaceView)
            {
                <h1>Astral Expanse</h1>
                <p>Orbiting Ark Colonization Station</p>
                
                <GuidanceOverlay 
                    IsTowingMode="@_isTowingMode" 
                    TowingTargetId="@_towingTargetId" 
                    StationPendingTowId="@_stationPendingTowId" 
                    NoTugsAvailable="@_noTugsAvailable" />
            }
            
            <div class="top-actions">
                <button class="btn-primary" @onclick='() => _showTacticalDB = true' style="border-color: #00d4ff; background: rgba(0,212,255,0.1); font-size: 0.7rem; padding: 4px 10px;">MISSION DATA</button>
            </div>

            <StatsOverlay />
            
            <SelectionOverlay 
                SelectedShipId="@_selectedShipId" 
                SelectedStationId="@_selectedStationId" 
                SelectedAsteroidId="@_selectedAsteroidId" 
                AsteroidOre="@(GameState.Asteroids.Find(a => a.Id == _selectedAsteroidId)?.Capacity ?? 0)"
                OnMineMonolith="HandleMineMonolith" />
        </div>
    </div>

    @if (GameState.IsVictoryAchieved)
    {
        <div class="victory-overlay">
            <div class="victory-content">
                <h1>ASCENSION ACHIEVED</h1>
                <p>The Stellar Expanse has been united. Your civilization has reached the stars and prospered.</p>
                <div class="victory-stats">
                    Global Population: @GameState.TotalPopulation / @GameStateService.VictoryPopulationTarget
                </div>
                <button class="btn-primary" @onclick="() => GameState.AddOre(0)">CONTINUE EXPLORING</button>
            </div>
        </div>
    }

    @if (_showTacticalDB)
    {
        <TacticalDatabase OnClose="() => _showTacticalDB = false" />
    }
}

<style>
    .victory-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.85);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10000;
        animation: victoryFadeIn 2s ease-out;
    }
    .victory-content {
        text-align: center;
        background: linear-gradient(135deg, #1a2a44 0%, #0d1522 100%);
        padding: 4rem;
        border: 2px solid #00d4ff;
        border-radius: 20px;
        box-shadow: 0 0 50px rgba(0, 212, 255, 0.4);
        max-width: 600px;
        color: white;
    }
    .victory-content h1 {
        font-size: 3.5rem;
        color: #00d4ff;
        margin-bottom: 2rem;
        text-shadow: 0 0 20px #00d4ff;
    }
    .victory-stats {
        font-size: 1.8rem;
        margin: 2rem 0;
        color: #ffcc00;
    }
    .top-actions {
        position: absolute;
        top: 20px;
        right: 20px;
        z-index: 100;
        pointer-events: auto;
    }
    @@keyframes victoryFadeIn { from { opacity: 0; } to { opacity: 1; } }
</style>

@code {
    private bool _showShipyard = false;
    private bool _showMiningMenu = false;
    private double _mouseX, _mouseY;
    private string? _selectedShipId;
    private string? _selectedStationId;
    private string? _targetAsteroidId;
    private string? _selectedAsteroidId;
    private float[]? _targetAsteroidPos;
    private bool _isTowingMode = false;
    private string? _towingTargetId;
    private string? _stationPendingTowId;
    private bool _noTugsAvailable = false;
    private bool _isSurfaceView = false;
    private string? _currentSurfacePlanetId;
    private Radar? _radar;
    private bool _isGameActive = false;
    private System.Timers.Timer? _saveTimer;
    private string? _shipyardStationId;
    private bool _showColonyMenu = false;
    private bool _showTacticalDB = false;

    private string? _lastObservedSectorId;
    private bool _isSceneInitializing = false;

    protected override void OnInitialized()
    {
        GameState.OnStateChanged += HandleStateChanged;
        BabylonService.OnObjectClicked += HandleObjectClicked;
        BabylonService.OnMoveComplete += HandleMoveComplete;
        BabylonService.OnEscapePressed += HandleEscape;
        BabylonService.OnMonolithDiscovered += HandleMonolithDiscovered;
        BabylonService.OnMinerUnloaded += HandleMinerUnloaded;
        _lastObservedSectorId = GameState.CurrentSectorId;
    }

    private async void HandleStateChanged()
    {
        if (_isSceneInitializing) return;

        if (_lastObservedSectorId != GameState.CurrentSectorId)
        {
            _lastObservedSectorId = GameState.CurrentSectorId;
            await InvokeAsync(async () => {
                await BabylonService.ClearScene();
                await Initialize3DScene(isLoad: true);
                StateHasChanged();
            });
        }
        else
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(500);
            _saveTimer = new System.Timers.Timer(10000);
            _saveTimer.Elapsed += async (s, e) => {
                if (_isGameActive) 
                {
                    await SyncPositionsToState();
                    await Persistence.SaveGame(GameState);
                }
            };
            _saveTimer.Enabled = true;
        }
    }

    private async Task HandleNewGame()
    {
        _isGameActive = false; // Temporarily deactivate to prevent render updates during clear
        await BabylonService.ClearScene();
        
        GameState.ResetState();
        await Persistence.ClearSave();
        
        // Build initial units for the new colonization effort
        // We do this BEFORE Initialize3DScene to ensure they are in the state
        await BuildNewShipInternal(GameUnitType.MinerUnit, "Ark_Colonization_Station");

        await Initialize3DScene(isLoad: true);
        _isGameActive = true;
        Farming.StartAutonomousCycle();
        Combat.StartCombatLoop();
        await Task.Delay(100);
        await JSRuntime.InvokeVoidAsync("AstralEngine.focusElement", ".ui-container");
        StateHasChanged();
    }

    private async Task HandleContinueGame()
    {
        var json = await Persistence.LoadGameJson();
        if (!string.IsNullOrEmpty(json))
        {
            var savedState = System.Text.Json.JsonSerializer.Deserialize<GameStateService>(json);
            GameState.LoadFromState(savedState);
        }
        await Initialize3DScene(isLoad: true);
        _isGameActive = true;
        await Task.Delay(200);
        await JSRuntime.InvokeVoidAsync("AstralEngine.focusElement", ".ui-container");
        await SyncPositionsToState();
        
        // Restart mission loops for ALL sectors
        Missions.RestartMissions();
        Farming.StartAutonomousCycle();
        Combat.StartCombatLoop();
        
        foreach (var sector in GameState.Sectors)
        {
            foreach (var m in sector.ActiveMissions.Values.Where(m => m.State == ShipState.Building))
            {
                _ = Construction.HandleConstructionSequence(m.ShipId, m.ConstructionTarget, sector.Id);
            }
        }

        // Cleanup the "Mess" if any
        GameState.PruneDuplicateShips("Ark_Colonization_Station");

        StateHasChanged();
    }

    private async void HandleEscape()
    {
        await InvokeAsync(async () => {
            if (RoverService.IsDriving)
            {
                await RoverService.ExitDriveMode();
                StateHasChanged();
                return;
            }

            if (_showColonyMenu)
            {
                _showColonyMenu = false;
                StateHasChanged();
                return;
            }

            if (_isGameActive)
            {
                await SyncPositionsToState();
                await Persistence.SaveGame(GameState);
                _isGameActive = false;
                StateHasChanged();
            }
        });
    }

    private async Task Initialize3DScene(bool isLoad = false)
    {
        if (_isSceneInitializing) return;
        _isSceneInitializing = true;

        try 
        {
            // Only load the Ark Station in the Home Sector
            if (GameState.CurrentSectorId == "Home_Sector")
            {
                var stationJson = await Http.GetStringAsync("assets/station.json");
                await BabylonService.LoadModel(stationJson, pos: new float[] { 0, 0, 0 }, id: "Ark_Colonization_Station");
                GameState.RegisterStation("Ark_Colonization_Station", new float[] { 0, 0, 0 }, "Home_Sector");
            }

            if (isLoad)
            {
                foreach (var asteroid in GameState.Asteroids.ToList()) 
                {
                    var astJson = await Http.GetStringAsync("assets/asteroid.json");
                    await BabylonService.LoadModel(astJson, asteroid.Position, asteroid.Scale, asteroid.Rotation, asteroid.Id);
                }
                foreach (var stationId in GameState.Stations.ToList())
                {
                    if (stationId == "Ark_Colonization_Station") continue;
                    var subJson = await Http.GetStringAsync("assets/substation.json");
                    var pos = GameState.StationPositions.TryGetValue(stationId, out var sPos) ? sPos : new float[] { 0, 0, 0 };
                    await BabylonService.LoadModel(subJson, pos: pos, id: stationId);
                }
                foreach (var planet in GameState.Planets.ToList())
                {
                    var pJson = Missions.GeneratePlanetJson(planet.Name);
                    await BabylonService.LoadModel(pJson, planet.Position, 50.0f, id: planet.Id);
                    
                    if (planet.IsColonized)
                    {
                        var cJson = await Http.GetStringAsync("assets/colony.json");
                        var hPos = new float[] { planet.Position[0], planet.Position[1] + 26.5f, planet.Position[2] };
                        await BabylonService.LoadModel(cJson, hPos, id: $"Hub_{planet.Id}");
                    }
                }
                foreach (var wormhole in GameState.Wormholes.ToList())
                {
                    var wormJson = await Http.GetStringAsync("assets/wormhole.json");
                    await BabylonService.LoadModel(wormJson, wormhole.Position, scale: 1.0f, id: wormhole.Id);
                }
                foreach (var npc in GameState.NPCShips.Values.ToList())
                {
                    var npcJson = await Http.GetStringAsync("assets/alien_fighter.json");
                    await JSRuntime.InvokeVoidAsync("AstralEngine.loadProceduralModel", npcJson, npc.Position, 3.0, new float[] { 0, 0, 0 }, npc.Id);
                    await JSRuntime.InvokeVoidAsync("eval", $"AstralEngine.scene.getNodeById('{npc.Id}').metadata = {{ isRoot: true, type: 'NPC', name: 'Alien Fighter' }}");
                }
                foreach (var mission in GameState.ActiveMissions.Values.ToList())
                {
                    if (mission.SectorId != GameState.CurrentSectorId) continue;
                    
                    var asset = GetUnitAsset(mission.Type);
                    var json = await Http.GetStringAsync($"assets/{asset}");
                    await BabylonService.LoadModel(json, mission.Position, id: mission.ShipId);
                    // Movement will be triggered by RestartMissions() after full scene load
                }
            }
            
            if (GameState.CurrentSectorId == "Home_Sector")
            {
                await CenterOnObject("Ark_Colonization_Station");
            }
            else if (GameState.Stations.Any())
            {
                await CenterOnObject(GameState.Stations[0]);
            }
        }
        finally
        {
            _isSceneInitializing = false;
        }
    }

    private async Task BuildNewShipInternal(GameUnitType type, string stationId) => await Construction.BuildNewShipFromStation(type, stationId);

    private async void HandleObjectClicked(string type, string name, string id)
    {
        _showMiningMenu = false;

        if (name == "Ark_Colonization_Station")
        {
            _selectedShipId = null;
            _selectedAsteroidId = null;
            _selectedStationId = id;
            await CenterOnObject(id);
        }
        else if (type == "Ship" || name.Contains("Ship") || name == "Venture_Mining_Vessel" || name == "Recon_Scout_Vessel" || name == "Apex_Interceptor" || name == "Titan_Tugboat" || name == "Colony_Ship_Vessel" || name == "Stellar_Probe" || name == "Wormhole Scout" || name == "Stellar Gatekeeper")
        {
            _selectedShipId = id;
            _selectedAsteroidId = null;
            _selectedStationId = null;
            await CenterOnObject(id);
            _isTowingMode = false;
        }
        else if (type == "Asteroid" || name == "Iron_Rich_Asteroid")
        {
            _selectedAsteroidId = id;
            _selectedStationId = null;
            
            if (IsSelectedShipOfType(GameUnitType.MinerUnit))
            {
                if (GameState.ActiveMissions.TryGetValue(_selectedShipId!, out var m) && m.State == ShipState.Idle)
                {
                    _targetAsteroidId = id;
                    _targetAsteroidPos = await BabylonService.GetModelPosition(id);
                    _mouseX = 400; _mouseY = 300;
                    _showMiningMenu = true;
                }
                else _selectedShipId = null;
            }
            else _selectedShipId = null;

            await CenterOnObject(id);
        }
        else if (name == "Modular_SubStation")
        {
            if (_isTowingMode && !string.IsNullOrEmpty(_selectedShipId))
            {
                _towingTargetId = id;
                await BabylonService.SetSelected(id);
            }
            else
            {
                _selectedShipId = null;
                _selectedStationId = id;
                await CenterOnObject(id);
            }
        }
        else if (type == "Monolith" || id.StartsWith("Monolith") || type == "Wormhole" || id.StartsWith("Wormhole"))
        {
            _selectedAsteroidId = id;
            _selectedShipId = null;
            _selectedStationId = null;
            await CenterOnObject(id);
        }
        else if (name == "Planet")
        {
            _selectedAsteroidId = id;
            if (IsSelectedShipOfType(GameUnitType.ColonyShipUnit)) await StartColonizationMission(id);
            else _selectedShipId = null;
            await CenterOnObject(id);
        }
        else if (name == "Planetary_Colony_Alpha" || id.StartsWith("Hub_"))
        {
            if (_isSurfaceView)
            {
                _showColonyMenu = true;
            }
            else
            {
                // In space, clickinghub might center or something
                await CenterOnObject(id);
            }
        }
        StateHasChanged();
    }

    private async void HandleMoveComplete(string id) { await Missions.HandleMoveComplete(id); await InvokeAsync(StateHasChanged); }

    private async Task BuildNewShip(GameUnitType type) { await Construction.BuildNewShipFromStation(type, _shipyardStationId ?? "Ark_Colonization_Station"); _showShipyard = false; StateHasChanged(); }

    private async Task StartMiningMission() { if (string.IsNullOrEmpty(_selectedShipId) || _targetAsteroidPos == null) return; await Missions.StartMiningMission(_selectedShipId, _selectedAsteroidId ?? "", _targetAsteroidPos); _showMiningMenu = false; StateHasChanged(); }

    private async Task StartColonizationMission(string id) { if (string.IsNullOrEmpty(_selectedShipId)) return; await Missions.StartColonizationMission(_selectedShipId, id); StateHasChanged(); }

    private void HandleInitiateStationTow(string id) { _stationPendingTowId = id; _isTowingMode = true; StateHasChanged(); }

    private async Task HandleRadarLocationSelected(float[] worldPos)
    {
        float x = worldPos[0];
        float z = worldPos[2];
        
        if (!string.IsNullOrEmpty(_stationPendingTowId))
        {
            var mission = GameState.ActiveMissions.Values.FirstOrDefault(m => m.Type == GameUnitType.TugboatUnit && m.State == ShipState.Idle);
            if (mission != null)
            {
                mission.State = ShipState.MovingToAsteroid;
                mission.AsteroidId = _stationPendingTowId;
                mission.AsteroidPosition = new float[] { x, 0, z };
                mission.CurrentTarget = GameState.StationPositions[_stationPendingTowId];
                await BabylonService.MoveModel(mission.ShipId, mission.CurrentTarget, 20.0f);
                _stationPendingTowId = null;
                _isTowingMode = false;
            }
            else { _noTugsAvailable = true; StateHasChanged(); await Task.Delay(3000); _noTugsAvailable = false; }
        }
        else { await BabylonService.SetCameraTarget(x, 0, z); _radar?.CenterOn(x, z); }
        StateHasChanged();
    }

    private async Task HandleStartMission(string shipId)
    {
        if (GameState.ActiveMissions.TryGetValue(shipId, out var m))
        {
            if (m.Type == GameUnitType.ScoutUnit) { m.State = ShipState.Searching; var wp = GetRandomWaypoint(600, 1000); m.CurrentTarget = wp; await BabylonService.MoveModel(shipId, wp, 40.0f); }
            else if (m.Type == GameUnitType.WormholeScoutUnit) { await Missions.StartWormholeScout(shipId); }
            else if (m.Type == GameUnitType.FighterUnit) { m.State = ShipState.Patrolling; var wp = GetRandomWaypoint(150, 300); m.CurrentTarget = wp; await BabylonService.MoveModel(shipId, wp, 30.0f); }
            else if (m.Type == GameUnitType.ProbeUnit) { await Missions.StartProbeSearch(shipId); }
            else if (m.Type == GameUnitType.ColonyShipUnit)
            {
                var target = GameState.Planets.Find(p => p.IsDiscovered && !p.IsColonized);
                if (target != null) await Missions.StartColonizationMission(shipId, target.Id);
            }
            else if (m.Type == GameUnitType.StellarGatekeeperUnit)
            {
                var target = GameState.Wormholes.Find(w => w.IsDiscovered);
                if (target != null) await Missions.StartStellarGatekeeperMission(shipId, target.Id);
            }
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleSelectShipFromPanel(string id) { _selectedShipId = id; _selectedStationId = null; await CenterOnObject(id); StateHasChanged(); }
    private async Task HandleSelectStation(string id) { _selectedStationId = id; _selectedShipId = null; await CenterOnObject(id); StateHasChanged(); }

    private async Task CenterOnObject(string id)
    {
        await BabylonService.SetSelected(id);
        var pos = await BabylonService.GetModelPosition(id);
        if (pos != null) { await BabylonService.SetCameraTarget(pos[0], pos[1], pos[2]); _radar?.CenterOn(pos[0], pos[2]); }
    }

    private void HandleStopMining(string id)
    {
        if (GameState.ActiveMissions.TryGetValue(id, out var m)) 
        { 
            m.StopRequested = true; 
            if (m.Type != GameUnitType.FighterUnit && m.State != ShipState.Mining && m.State != ShipState.MovingToAsteroid) 
                m.State = ShipState.Idle; 
            StateHasChanged(); 
        }
    }

    private bool IsSelectedShipOfType(GameUnitType t) => GameState.ActiveMissions.TryGetValue(_selectedShipId ?? "", out var m) && m.Type == t;

    private async Task VisitColony(string id) 
    { 
        _isSurfaceView = true; 
        _currentSurfacePlanetId = id; 
        Farming.CurrentPlanetId = id;
        await BabylonService.SetSurfaceView(id); 
        await Colony.LoadColonyBuildings(id);
        var planet = GameState.Planets.Find(p => p.Id == id);
        if (planet != null)
        {
            _radar?.CenterOn(planet.Position[0], planet.Position[2]);
        }
        StateHasChanged(); 
    }

    private void HandleMonolithDiscovered(string id)
    {
        var planet = GameState.Planets.Find(p => p.Monoliths.Any(m => m.Id == id));
        if (planet != null)
        {
            var m = planet.Monoliths.Find(mon => mon.Id == id);
            if (m != null)
            {
                m.IsDiscovered = true;
                _ = InvokeAsync(StateHasChanged);
            }
        }
    }

    private void HandleMinerUnloaded(string id, int amount)
    {
        GameState.AddAetherShards(amount);
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task HandleMineMonolith(string monolithId)
    {
        if (monolithId.StartsWith("Wormhole"))
        {
            await StartExplorationMission(monolithId);
            return;
        }

        if (string.IsNullOrEmpty(_currentSurfacePlanetId)) return;
        if (await Colony.BuildSurfaceMiner(_currentSurfacePlanetId, monolithId))
        {
            _selectedAsteroidId = null;
            await BabylonService.SetSelected(null);
            StateHasChanged();
        }
    }

    private async Task StartExplorationMission(string wormholeId)
    {
        var wormhole = GameState.Wormholes.Find(w => w.Id == wormholeId);
        if (wormhole == null) return;

        // In a real game, this might require a massive ship
        // For now, let's trigger the Gatekeeper construction at the main station
        await Construction.BuildNewShipFromStation(GameUnitType.StellarGatekeeperUnit, "Ark_Colonization_Station");
        
        _selectedAsteroidId = null;
        await BabylonService.SetSelected(null);
        StateHasChanged();
    }
    private async Task ExitSurfaceView() 
    { 
        _isSurfaceView = false; 
        _showColonyMenu = false; 
        Farming.CurrentPlanetId = null;
        await BabylonService.SetSpaceView(); 
        if (RoverService.IsDriving) await RoverService.ExitDriveMode();
        await CenterOnObject("Ark_Colonization_Station"); 
        StateHasChanged(); 
    }

    private async Task SyncPositionsToState() 
    { 
        // Sync models for ALL sectors (only those visible in 3D right now will return a position)
        foreach (var sector in GameState.Sectors)
        {
            foreach (var id in sector.ActiveMissions.Keys.ToList()) 
            { 
                var pos = await BabylonService.GetModelPosition(id); 
                if (pos != null) sector.ActiveMissions[id].Position = pos; 
            } 
        }
    }

    private string GetUnitAsset(GameUnitType t) => t switch { 
        GameUnitType.MinerUnit => "miner.json", 
        GameUnitType.ScoutUnit => "scout.json", 
        GameUnitType.FighterUnit => "fighter.json", 
        GameUnitType.TugboatUnit => "tugboat.json", 
        GameUnitType.ColonyShipUnit => "colony_ship.json", 
        GameUnitType.ProbeUnit => "miner.json",
        GameUnitType.WormholeScoutUnit => "wormhole_scout.json",
        GameUnitType.StellarGatekeeperUnit => "stellar_gatekeeper.json",
        _ => "miner.json" 
    };
    private float GetMoveDuration(float[] s, float[] e, float speed) { float d = (float)Math.Sqrt(Math.Pow(s[0]-e[0],2)+Math.Pow(s[1]-e[1],2)+Math.Pow(s[2]-e[2],2)); return Math.Max(0.5f, d/speed); }
    private float[] GetRandomWaypoint(float min, float max) { var r = new Random(); var a = r.NextDouble() * Math.PI * 2; var d = min + (r.NextDouble() * (max - min)); return new float[] { (float)(Math.Cos(a)*d), 0, (float)(Math.Sin(a)*d) }; }

    public void Dispose()
    {
        GameState.OnStateChanged -= StateHasChanged;
        BabylonService.OnObjectClicked -= HandleObjectClicked;
        BabylonService.OnMoveComplete -= HandleMoveComplete;
        BabylonService.OnEscapePressed -= HandleEscape;
        BabylonService.OnMonolithDiscovered -= HandleMonolithDiscovered;
        BabylonService.OnMinerUnloaded -= HandleMinerUnloaded;
        _saveTimer?.Dispose();
    }

    private async Task HandleKeyDown(KeyboardEventArgs e) => await RoverService.HandleKeyDown(e.Key);
    private async Task HandleKeyUp(KeyboardEventArgs e) => await RoverService.HandleKeyUp(e.Key);
}
