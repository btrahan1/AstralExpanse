@page "/"
@using AstralExpanse.Services
@using AstralExpanse.Components
@inject BabylonService BabylonService
@inject GameStateService GameState
@inject PersistenceService Persistence
@inject IJSRuntime JSRuntime
@inject HttpClient Http
@implements IDisposable

<PageTitle>Astral Expanse</PageTitle>

<Viewport />

@if (!_isGameActive)
{
    <MainMenu OnNewGame="HandleNewGame" OnContinueGame="HandleContinueGame" />
}

@if (_isGameActive)
{
    @if (_showShipyard)
    {
        <ShipyardMenu Show="_showShipyard" OnClose="() => _showShipyard = false" OnBuildShip="BuildNewShip" />
    }

    <MiningMenu Show="_showMiningMenu" X="_mouseX" Y="_mouseY" OnStartMining="StartMiningMission" />

    <FleetPanel SelectedShipId="@_selectedShipId" OnSelectShip="HandleSelectShipFromPanel" OnVisitPlanet="VisitColony" OnStopMining="HandleStopMining" OnStartMission="HandleStartMission" OnInitiateTow="id => _isTowingMode = true" />
    
    @if (_isSurfaceView)
    {
        <div class="surface-overlay">
            <button class="btn-return" @onclick="ExitSurfaceView">RETURN TO SPACE</button>
        </div>
    }

    <StationPanel SelectedStationId="@_selectedStationId" OnSelectStation="HandleSelectStation" OnOpenShipyard="id => { _shipyardStationId = id; _showShipyard = true; }" OnInitiateStationTow="HandleInitiateStationTow" />

    <Radar @ref="_radar" Visible="@(!_isSurfaceView)" OnLocationSelected="HandleRadarLocationSelected" />

    <div class="ui-container" tabindex="-1">
        <div class="ui-overlay">
            <h1>Astral Expanse</h1>
            <p>Orbiting Ark Colonization Station</p>
            <div class="stats">
                <span>Ore: <strong>@GameState.Ore</strong></span> | 
                <span>Fleet: <strong>@GameState.Fleet.Count</strong></span>
            </div>
            @if (!string.IsNullOrEmpty(_selectedShipId))
            {
                var parts = _selectedShipId.Split('_');
                var typeStr = parts.Length > 1 ? parts[1] : "Unit";
                var idStr = parts.Length > 2 ? parts[2] : "001";
                <div class="selection-info">
                    Selected: <span class="ship-id">@typeStr @idStr</span>
                </div>
            }
            
            @if (!string.IsNullOrEmpty(_selectedAsteroidId))
            {
                var asteroid = GameState.Asteroids.Find(a => a.Id == _selectedAsteroidId);
                if (asteroid != null)
                {
                    <div class="selection-info asteroid-info">
                        Target: <span class="ship-id">@asteroid.Name</span><br/>
                        Capacity: <span class="ore-stat">@asteroid.Capacity.ToString("N0")</span> <span style="font-size: 0.7rem; color: #88ccff;">Ore Remaining</span>
                    </div>
                }
            }
            
            @if (_isTowingMode || !string.IsNullOrEmpty(_towingTargetId) || !string.IsNullOrEmpty(_stationPendingTowId))
            {
                <div class="guidance-hud">
                    @if (!string.IsNullOrEmpty(_stationPendingTowId))
                    {
                        <span class="success">SELECT DESTINATION ON RADAR</span>
                    }
                    else if (string.IsNullOrEmpty(_towingTargetId))
                    {
                        <span class="warning">SELECT SUBSTATION TO TOW</span>
                    }
                    else
                    {
                        <span class="success">SELECT DESTINATION ON RADAR</span>
                    }
                </div>
            }
            
            @if (_noTugsAvailable)
            {
                <div class="guidance-hud">
                    <span class="warning">NO IDLE TUGBOATS AVAILABLE</span>
                </div>
            }
        </div>
    </div>
}

@code {
    private bool _showShipyard = false;
    private bool _showMiningMenu = false;
    private double _mouseX, _mouseY;
    private string? _selectedShipId;
    private string? _selectedStationId;
    private string? _targetAsteroidId;
    private string? _selectedAsteroidId;
    private float[]? _targetAsteroidPos;
    private bool _isTowingMode = false;
    private string? _towingTargetId;
    private string? _stationPendingTowId;
    private bool _noTugsAvailable = false;
    private bool _isSurfaceView = false;
    private string? _currentSurfacePlanetId;
    private Radar? _radar;
    private bool _isGameActive = false;
    private System.Timers.Timer? _saveTimer;

    protected override void OnInitialized()
    {
        GameState.OnStateChanged += StateHasChanged;
        BabylonService.OnObjectClicked += HandleObjectClicked;
        BabylonService.OnMoveComplete += HandleMoveComplete;
        BabylonService.OnEscapePressed += HandleEscape;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Task.Delay(500);
            
            // Setup auto-save timer
            _saveTimer = new System.Timers.Timer(10000); // 10 seconds (more frequent for position sync)
            _saveTimer.Elapsed += async (s, e) => {
                if (_isGameActive) 
                {
                    await SyncPositionsToState();
                    await Persistence.SaveGame(GameState);
                }
            };
            _saveTimer.Enabled = true;

            // Note: Objects are spawned in HandleNewGame or HandleContinueGame
        }
    }

    private async Task HandleNewGame()
    {
        GameState.ResetState();
        await Persistence.ClearSave();
        
        // Initial setup for new game
        await Initialize3DScene();
        
        _isGameActive = true;
        await Task.Delay(100); // Wait for render
        await JSRuntime.InvokeVoidAsync("AstralEngine.focusElement", ".ui-container");
        StateHasChanged();
    }

    private async Task HandleContinueGame()
    {
        var json = await Persistence.LoadGameJson();
        if (!string.IsNullOrEmpty(json))
        {
            var savedState = System.Text.Json.JsonSerializer.Deserialize<GameStateService>(json);
            GameState.LoadFromState(savedState);
        }
        
        await Initialize3DScene(isLoad: true);
        
        _isGameActive = true;
        await Task.Delay(200); // Wait for things to settle
        await JSRuntime.InvokeVoidAsync("AstralEngine.focusElement", ".ui-container");
        
        // Immediate sync to capture loaded positions
        await SyncPositionsToState();
        StateHasChanged();
    }

    private async void HandleEscape()
    {
        await InvokeAsync(async () => {
            if (_isGameActive)
            {
                await SyncPositionsToState();
                await Persistence.SaveGame(GameState);
                _isGameActive = false;
                StateHasChanged();
            }
        });
    }

    private async Task Initialize3DScene(bool isLoad = false)
    {
        // Load Station
        var stationJson = await Http.GetStringAsync("assets/station.json");
        
        if (!isLoad)
        {
            // Initial Ark Station
            await BabylonService.LoadModel(stationJson, id: "Ark_Colonization_Station");
            GameState.RegisterStation("Ark_Colonization_Station", new float[] { 0, 0, 0 });
            
            // Initial Asteroid Field
            await SpawnAsteroidField(new float[] { 0, 0, 0 }, 20, 400);
        }
        else
        {
            // Reconstruct from state
            foreach (var stationId in GameState.Stations)
            {
                var asset = stationId == "Ark_Colonization_Station" ? "station.json" : "substation.json";
                var json = await Http.GetStringAsync($"assets/{asset}");
                
                var pos = GameState.StationPositions.TryGetValue(stationId, out var savedPos) ? savedPos : new float[] { 0, 0, 0 };
                await BabylonService.LoadModel(json, pos: pos, id: stationId);
            }

            foreach (var planet in GameState.Planets)
            {
                if (planet.IsDiscovered)
                {
                    var json = await GeneratePlanetJson(planet.Name);
                    await BabylonService.LoadModel(json, pos: planet.Position, scale: 50.0f, id: planet.Id);

                    if (planet.IsColonized)
                    {
                        var colonyJson = await Http.GetStringAsync("assets/colony.json");
                        float[] colonyPos = new float[] { planet.Position[0], planet.Position[1] + 25, planet.Position[2] };
                        await BabylonService.LoadModel(colonyJson, pos: colonyPos, id: $"Hub_{planet.Id}");
                    }
                }
            }

            foreach (var shipId in GameState.Fleet)
            {
                if (GameState.ActiveMissions.TryGetValue(shipId, out var mission))
                {
                    var asset = mission.Type switch {
                        GameUnitType.MinerUnit => "miner.json",
                        GameUnitType.ScoutUnit => "scout.json",
                        GameUnitType.FighterUnit => "fighter.json",
                        GameUnitType.TugboatUnit => "tugboat.json",
                        GameUnitType.ColonyShipUnit => "colony_ship.json",
                        _ => "miner.json"
                    };
                    var json = await Http.GetStringAsync($"assets/{asset}");
                    await BabylonService.LoadModel(json, pos: mission.Position, rot: mission.Rotation, id: shipId);
                }
            }

            // Load asteroids from state
            var asteroidJson = await Http.GetStringAsync("assets/asteroid.json");
            foreach (var asteroid in GameState.Asteroids)
            {
                if (asteroid.Capacity > 0)
                {
                    await BabylonService.LoadModel(asteroidJson, pos: asteroid.Position, rot: asteroid.Rotation, scale: asteroid.Scale, id: asteroid.Id);
                }
            }

            // Kick off missions
            await ResumeMissions();
        }
    }

    private async Task SpawnAsteroidField(float[] center, int count, float radius)
    {
        var asteroidJson = await Http.GetStringAsync("assets/asteroid.json");
        var rnd = new Random();
        var modelsToLoad = new List<ModelLoadData>();
        
        for (int i = 0; i < count; i++)
        {
            float angle = (float)(rnd.NextDouble() * Math.PI * 2);
            float dist = (float)(rnd.NextDouble() * radius * 0.8 + radius * 0.2);
            float x = center[0] + (float)Math.Cos(angle) * dist;
            float z = center[2] + (float)Math.Sin(angle) * dist;
            float y = center[1] + (float)(rnd.NextDouble() * 40 - 20);
            
            var pos = new float[] { x, y, z };
            var rot = new float[] { (float)rnd.NextDouble() * 6, (float)rnd.NextDouble() * 6, (float)rnd.NextDouble() * 6 };
            float scale = (float)(rnd.NextDouble() * 0.5 + 0.7);
            string id = $"Asteroid_{Guid.NewGuid().ToString().Substring(0, 8)}";
            string name = $"Iron-Rich Asteroid {GameState.Asteroids.Count + modelsToLoad.Count + 1:D3}";

            var data = new AsteroidData {
                Id = id,
                Name = name,
                Position = pos,
                Rotation = rot,
                Scale = scale,
                Capacity = 10000
            };
            GameState.Asteroids.Add(data);
            
            modelsToLoad.Add(new ModelLoadData {
                Id = id,
                JsonData = asteroidJson,
                Position = pos,
                Rotation = rot,
                Scale = scale
            });
        }

        try 
        {
            await BabylonService.LoadModels(modelsToLoad);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Batch load warning (likely external script conflict): {ex.Message}");
            // Continue anyway as the state is updated
        }
    }

    private async Task SyncPositionsToState()
    {
        foreach (var shipId in GameState.Fleet)
        {
            var pos = await BabylonService.GetModelPosition(shipId);
            if (pos != null && GameState.ActiveMissions.TryGetValue(shipId, out var mission))
            {
                mission.Position = pos;
            }
        }
        
        foreach (var stationId in GameState.Stations)
        {
            var pos = await BabylonService.GetModelPosition(stationId);
            if (pos != null) GameState.StationPositions[stationId] = pos;
        }
    }

    private async Task ResumeMissions()
    {
        // Resume Ship Missions
        foreach (var shipId in GameState.Fleet)
        {
            await ResumeUnitMission(shipId);
        }

        // Resume Station Missions (for building substations)
        foreach (var stationId in GameState.Stations)
        {
            if (stationId != "Ark_Colonization_Station")
            {
                await ResumeUnitMission(stationId);
            }
        }
    }

    private async Task ResumeUnitMission(string id)
    {
        if (GameState.ActiveMissions.TryGetValue(id, out var mission))
        {
            // If it was moving, restart movement to its current target
            if (mission.State == ShipState.MovingToAsteroid || 
                mission.State == ShipState.ReturningToStation ||
                mission.State == ShipState.Scouting ||
                mission.State == ShipState.Patrolling)
            {
                float dist = GetDistance(mission.Position, mission.CurrentTarget);
                float duration = dist / 20.0f; // Approx speed
                await BabylonService.MoveModel(id, mission.CurrentTarget, Math.Max(1, duration));
            }
            else if (mission.State == ShipState.Mining)
            {
                _ = HandleMiningSequence(id);
            }
            else if (mission.State == ShipState.Unloading)
            {
                _ = HandleUnloadingSequence(id);
            }
            else if (mission.State == ShipState.Towing && !string.IsNullOrEmpty(mission.TowedEntityId))
            {
                await BabylonService.AttachToParent(mission.TowedEntityId, id);
            }
            else if (mission.State == ShipState.Building)
            {
                _ = HandleConstructionSequence(id, mission.ConstructionTarget);
            }
        }
    }

    private async Task HandleMiningSequence(string id)
    {
        if (GameState.ActiveMissions.TryGetValue(id, out var mission))
        {
            mission.Cargo = 0;
            for (int i = 0; i < 10; i++)
            {
                await Task.Delay(1000);
                mission.Cargo += 10;
                await InvokeAsync(StateHasChanged);
            }
            
            // Deplete asteroid
            if (!string.IsNullOrEmpty(mission.AsteroidId))
            {
                GameState.DepleteAsteroid(mission.AsteroidId, 100);
                
                var asteroid = GameState.Asteroids.Find(a => a.Id == mission.AsteroidId);
                if (asteroid != null && asteroid.Capacity <= 0)
                {
                    // Visual destruction
                    await BabylonService.DestroyModel(mission.AsteroidId, "collapse");
                    if (_selectedAsteroidId == mission.AsteroidId) _selectedAsteroidId = null;
                }
            }

            mission.State = ShipState.ReturningToStation;
            var target = GameState.StationPositions.TryGetValue(mission.ParentStationId, out var stationPos) ? stationPos : new float[] { 0, 0, 0 };
            mission.CurrentTarget = target;
            var shipPos = await BabylonService.GetModelPosition(id) ?? mission.Position;
            await BabylonService.MoveModel(id, target, GetMoveDuration(shipPos, target, 20.0f));
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleUnloadingSequence(string id)
    {
        if (GameState.ActiveMissions.TryGetValue(id, out var mission))
        {
            for (int i = 0; i < 5; i++)
            {
                await Task.Delay(1000);
                mission.Cargo -= 20;
                await InvokeAsync(StateHasChanged);
            }
            mission.Cargo = 0;
            GameState.AddOre(100);
            
            if (mission.StopRequested)
            {
                mission.State = ShipState.Idle;
                mission.StopRequested = false;
            }
            else
            {
                // Restart mining loop
                mission.State = ShipState.MovingToAsteroid;
                mission.CurrentTarget = mission.AsteroidPosition;
                var shipPos = await BabylonService.GetModelPosition(id) ?? mission.Position;
                await BabylonService.MoveModel(id, mission.AsteroidPosition, GetMoveDuration(shipPos, mission.AsteroidPosition, 20.0f));
            }
            await InvokeAsync(StateHasChanged);
        }
    }

    private float GetDistance(float[] p1, float[] p2)
    {
        return (float)Math.Sqrt(Math.Pow(p1[0] - p2[0], 2) + Math.Pow(p1[1] - p2[1], 2) + Math.Pow(p1[2] - p2[2], 2));
    }

    private float GetMoveDuration(float[] start, float[] end, float speed)
    {
        float dist = GetDistance(start, end);
        return Math.Max(0.5f, dist / speed);
    }

    private async void HandleObjectClicked(string name, string id)
    {
        _showMiningMenu = false;
        _selectedAsteroidId = null;

        if (name == "Ark_Colonization_Station")
        {
            _selectedShipId = null;
            _selectedStationId = id;
            await CenterOnObject(id);
            StateHasChanged();
        }
        else if (name == "Venture_Mining_Vessel" || name == "Recon_Scout_Vessel" || name == "Apex_Interceptor" || name == "Titan_Tugboat" || name == "Colony_Ship_Vessel" || name == "Stellar_Probe")
        {
            _selectedShipId = id;
            _selectedStationId = null;
            await CenterOnObject(id);
            _showShipyard = false;
            _isTowingMode = false; // Reset towing mode if we select a new ship
            StateHasChanged();
        }
        else if (name == "Modular_SubStation")
        {
            if (_isTowingMode && !string.IsNullOrEmpty(_selectedShipId))
            {
                _towingTargetId = id;
                await BabylonService.SetSelected(id);
                // Now waiting for radar click
                StateHasChanged();
            }
            else
            {
                _selectedShipId = null; // Can't select station as a ship
                _selectedStationId = id;
                await CenterOnObject(id);
                StateHasChanged();
            }
        }
        else if (name == "Iron_Rich_Asteroid")
        {
            _selectedAsteroidId = id;
            if (IsSelectedShipOfType(AstralExpanse.Services.GameUnitType.MinerUnit))
            {
                // Check if ship is building
                if (GameState.ActiveMissions.TryGetValue(_selectedShipId!, out var shipMission) && shipMission.State != ShipState.Building)
                {
                    _targetAsteroidId = id;
                    _targetAsteroidPos = await BabylonService.GetModelPosition(id);
                    _mouseX = 400; 
                    _mouseY = 300;
                    _showMiningMenu = true;
                }
            }
            await CenterOnObject(id);
            StateHasChanged();
        }
        else if (name == "Planet")
        {
            _selectedStationId = null;
            _selectedAsteroidId = id; // Reuse this for selection for now
            
            // Check if we have a Colony Ship selected
            if (IsSelectedShipOfType(GameUnitType.ColonyShipUnit))
            {
                // Assign colonization mission
                _ = StartColonizationMission(id);
            }
            else
            {
                // ONLY clear ship selection if it's NOT a colony ship or no ship selected
                _selectedShipId = null;
            }
            
            await CenterOnObject(id);
            StateHasChanged();
        }
    }

    private async Task StartColonizationMission(string planetId)
    {
        if (string.IsNullOrEmpty(_selectedShipId)) return;
        
        var planet = GameState.Planets.Find(p => p.Id == planetId);
        if (planet == null || planet.IsColonized) return;

        if (GameState.ActiveMissions.TryGetValue(_selectedShipId, out var mission))
        {
            mission.State = ShipState.MovingToAsteroid; // Use this as "Moving to Planet"
            mission.AsteroidId = planetId;
            mission.AsteroidPosition = planet.Position;
            
            var shipPos = await BabylonService.GetModelPosition(_selectedShipId) ?? mission.Position;
            await BabylonService.MoveModel(_selectedShipId, planet.Position, GetMoveDuration(shipPos, planet.Position, 20.0f));
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool IsSelectedShipOfType(AstralExpanse.Services.GameUnitType unitType)
    {
        if (string.IsNullOrEmpty(_selectedShipId)) return false;
        if (GameState.ActiveMissions.TryGetValue(_selectedShipId, out var mission))
        {
            return mission.Type == unitType;
        }
        return false;
    }

    private async Task StartMiningMission()
    {
        if (string.IsNullOrEmpty(_selectedShipId) || _targetAsteroidPos == null) return;

        // Preserve existing mission data (like ParentStationId) if it exists
        if (GameState.ActiveMissions.TryGetValue(_selectedShipId, out var existingMission))
        {
            existingMission.AsteroidId = _targetAsteroidId!;
            existingMission.AsteroidPosition = _targetAsteroidPos;
            existingMission.State = ShipState.MovingToAsteroid;
            existingMission.StopRequested = false;
        }
        else
        {
            // Fallback for new missions (though they should usually exist)
            var mission = new ShipMission {
                ShipId = _selectedShipId,
                AsteroidId = _targetAsteroidId!,
                AsteroidPosition = _targetAsteroidPos,
                State = ShipState.MovingToAsteroid,
                ParentStationId = "Ark_Colonization_Station"
            };
            GameState.ActiveMissions[_selectedShipId] = mission;
        }

        _showMiningMenu = false;

        var shipPos = await BabylonService.GetModelPosition(_selectedShipId) ?? new float[] { 0, 0, 0 };
        await BabylonService.MoveModel(_selectedShipId, _targetAsteroidPos, GetMoveDuration(shipPos, _targetAsteroidPos, 20.0f));
    }

    private async void HandleMoveComplete(string id)
    {
        if (GameState.ActiveMissions.TryGetValue(id, out var mission))
        {
            if (mission.State == AstralExpanse.Services.ShipState.MovingToAsteroid && mission.Type == AstralExpanse.Services.GameUnitType.MinerUnit)
            {
                mission.State = ShipState.Mining;
                _ = HandleMiningSequence(id);
            }
            else if (mission.State == ShipState.ReturningToStation)
            {
                mission.State = ShipState.Unloading;
                _ = HandleUnloadingSequence(id);
            }
            else if (mission.State == AstralExpanse.Services.ShipState.MovingToAsteroid && mission.Type == AstralExpanse.Services.GameUnitType.TugboatUnit)
            {
                // Tug arrived at SubStation
                mission.State = ShipState.Towing;
                await BabylonService.AttachToParent(mission.AsteroidId, id); // Attach substation to tugboat
                await InvokeAsync(StateHasChanged);
                
                // Move both to final destination
                var currentShipPos = await BabylonService.GetModelPosition(id) ?? new float[] { 0, 0, 0 };
                await BabylonService.MoveModel(id, mission.AsteroidPosition, GetMoveDuration(currentShipPos, mission.AsteroidPosition, 10.0f)); // Towing is slower
            }
            else if (mission.State == AstralExpanse.Services.ShipState.Towing)
            {
                // Towing complete
                mission.State = ShipState.Idle;
                await BabylonService.DetachFromParent(mission.AsteroidId, mission.AsteroidPosition); // Detach at target
                
                // Trigger auto-scan for asteroids at destination
                await SpawnAsteroidField(mission.AsteroidPosition, 6, 150); // Scan and find 6 local asteroids
                
                await InvokeAsync(StateHasChanged);
            }
            else if (mission.State == ShipState.Scouting)
            {
                // Move to a new random distant location
                var randomPos = GetRandomWaypoint(600, 1000);
                mission.CurrentTarget = randomPos;
                var shipPos = await BabylonService.GetModelPosition(id) ?? mission.Position;
                await BabylonService.MoveModel(id, randomPos, GetMoveDuration(shipPos, randomPos, 40.0f)); // Scouts are fast
            }
            else if (mission.State == ShipState.Patrolling)
            {
                // Move to a random waypoint nearby
                var randomPos = GetRandomWaypoint(150, 300);
                mission.CurrentTarget = randomPos;
                var shipPos = await BabylonService.GetModelPosition(id) ?? mission.Position;
                await BabylonService.MoveModel(id, randomPos, GetMoveDuration(shipPos, randomPos, 30.0f)); // Fighters are nimble
                await InvokeAsync(StateHasChanged);
            }
            else if (mission.Type == GameUnitType.ColonyShipUnit && mission.State == ShipState.MovingToAsteroid)
            {
                // Arrived at Planet
                mission.State = ShipState.Colonizing;
                _ = HandleColonizationSequence(id, mission.AsteroidId);
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task HandleColonizationSequence(string shipId, string planetId)
    {
        // 5 second establish sequence
        await Task.Delay(5000);
        
        var planet = GameState.Planets.Find(p => p.Id == planetId);
        if (planet != null)
        {
            planet.IsColonized = true;

            // Spawn the Colony Hub Asset!
            var colonyJson = await Http.GetStringAsync("assets/colony.json");
            // Offset from planet center to surface (planet scale is 50, so radius is 25)
            float[] colonyPos = new float[] { planet.Position[0], planet.Position[1] + 25, planet.Position[2] };
            await BabylonService.LoadModel(colonyJson, pos: colonyPos, id: $"Hub_{planetId}");
        }

        // Colony Ship transforms/consumes itself to build the hub
        GameState.Fleet.Remove(shipId);
        GameState.ActiveMissions.Remove(shipId);
        await BabylonService.DestroyModel(shipId, "collapse");
        
        await InvokeAsync(StateHasChanged);
    }

    private float[] GetRandomWaypoint(float minRadius, float maxRadius)
    {
        var random = new Random();
        var angle = random.NextDouble() * Math.PI * 2;
        var radius = minRadius + (random.NextDouble() * (maxRadius - minRadius));
        return new float[] { 
            (float)(Math.Cos(angle) * radius), 
            (float)((random.NextDouble() - 0.5) * 40), // Slight Y variation
            (float)(Math.Sin(angle) * radius) 
        };
    }

    private async Task BuildNewShip(AstralExpanse.Services.GameUnitType unitType)
    {
        await BuildNewShipFromStation(unitType, _shipyardStationId ?? "Ark_Colonization_Station");
    }

    private string? _shipyardStationId;

    private async Task BuildNewShipFromStation(AstralExpanse.Services.GameUnitType unitType, string builderStationId)
    {
        int cost = unitType switch {
            AstralExpanse.Services.GameUnitType.MinerUnit => 100,
            AstralExpanse.Services.GameUnitType.ScoutUnit => 150,
            AstralExpanse.Services.GameUnitType.FighterUnit => 250,
            AstralExpanse.Services.GameUnitType.TugboatUnit => 300,
            AstralExpanse.Services.GameUnitType.SubStationUnit => 500,
            _ => 100
        };

        if (GameState.TryBuildShip(unitType.ToString(), cost))
        {
            var id = unitType == AstralExpanse.Services.GameUnitType.SubStationUnit ? 
                $"Station_Sub_{Guid.NewGuid().ToString()[..8]}" : 
                $"Ship_{unitType}_{Guid.NewGuid().ToString()[..8]}";
            
            var asset = unitType switch {
                AstralExpanse.Services.GameUnitType.MinerUnit => "miner.json",
                AstralExpanse.Services.GameUnitType.ScoutUnit => "scout.json",
                AstralExpanse.Services.GameUnitType.FighterUnit => "fighter.json",
                AstralExpanse.Services.GameUnitType.TugboatUnit => "tugboat.json",
                AstralExpanse.Services.GameUnitType.SubStationUnit => "substation.json",
                AstralExpanse.Services.GameUnitType.ProbeUnit => "miner.json", // Placeholder for now
                AstralExpanse.Services.GameUnitType.ColonyShipUnit => "colony_ship.json",
                _ => "miner.json"
            };
            
            var stationPos = GameState.StationPositions.TryGetValue(builderStationId, out var sPos) ? sPos : new float[] { 0, 0, 0 };
            var spawnPos = unitType == AstralExpanse.Services.GameUnitType.SubStationUnit ? 
                new float[] { stationPos[0], stationPos[1], stationPos[2] + 120 } : 
                new float[] { stationPos[0], stationPos[1], stationPos[2] };

            var json = await Http.GetStringAsync($"assets/{asset}");
            
            // If using placeholders, inject the correct name into JSON
            if (unitType == GameUnitType.ProbeUnit) json = json.Replace("\"Name\": \"Venture_Mining_Vessel\"", "\"Name\": \"Stellar_Probe\"");
            // Colony ship no longer needs replacement as it has its own file

            // Register immediately so it shows in UI as "Building"
            float buildDuration = cost / 10.0f; // 1s per 10 ore
            
            var mission = new ShipMission { 
                ShipId = id, 
                Type = unitType, 
                State = AstralExpanse.Services.ShipState.Building,
                Position = spawnPos,
                ParentStationId = builderStationId,
                ConstructionProgress = 0,
                ConstructionTarget = buildDuration
            };
            
            GameState.ActiveMissions[id] = mission;
            
            if (unitType != AstralExpanse.Services.GameUnitType.SubStationUnit)
            {
                GameState.RegisterShip(id);
            }
            else
            {
                GameState.RegisterStation(id, spawnPos);
            }

            // Start construction in engine (maybe a ghost effect later)
            await BabylonService.LoadModel(json, spawnPos, id: id);
            
            _showShipyard = false;
            await InvokeAsync(StateHasChanged);
            
            // Start the build task
            _ = HandleConstructionSequence(id, buildDuration);
        }
    }

    private async Task HandleConstructionSequence(string id, float durationSeconds)
    {
        if (GameState.ActiveMissions.TryGetValue(id, out var mission))
        {
            float elapsed = (mission.ConstructionProgress / 100.0f) * durationSeconds;
            int steps = 20; // 20 updates per sequence
            float stepDuration = durationSeconds / steps;

            while (mission.ConstructionProgress < 100)
            {
                await Task.Delay(500); // Update every half second
                elapsed += 0.5f;
                mission.ConstructionProgress = Math.Min(100, (elapsed / durationSeconds) * 100);
                await InvokeAsync(StateHasChanged);
                
                if (mission.ConstructionProgress >= 100) break;
            }

            mission.State = ShipState.Idle;
            mission.ConstructionProgress = 100;

            if (mission.Type == GameUnitType.ProbeUnit)
            {
                // Auto-launch probe search
                mission.State = ShipState.Searching;
                _ = HandleProbeSearchSequence(id);
            }

            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleProbeSearchSequence(string probeId)
    {
        if (GameState.ActiveMissions.TryGetValue(probeId, out var mission))
        {
            // Probe search takes 3 minutes (180 seconds)
            // For testing/demo purposes, we could make it shorter, but let's stick to the prompt's 3 mins
            int searchDurationSeconds = 180;
            int updates = 36; // Update progress every 5 seconds
            
            for (int i = 0; i < updates; i++)
            {
                await Task.Delay(5000); // 5 sec update
                // We could use ConstructionProgress as a general "Mission Progress" bar here too
                // or just let it stay in "Searching" state.
                if (GameState.ActiveMissions.ContainsKey(probeId) == false) return; // Ship gone
            }

            // Discovery!
            await SpawnPlanet();
            
            // Destroy probe after use
            GameState.Fleet.Remove(probeId);
            GameState.ActiveMissions.Remove(probeId);
            await BabylonService.DestroyModel(probeId, "collapse");
            
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SpawnPlanet()
    {
        var rnd = new Random();
        string id = $"Planet_{Guid.NewGuid().ToString()[..8]}";
        string name = "Aethelgard Prime"; // Maybe randomize later
        
        // Spawn far away but reachable
        float angle = (float)(rnd.NextDouble() * Math.PI * 2);
        float dist = 2500.0f; 
        float[] pos = new float[] { 
            (float)Math.Cos(angle) * dist, 
            0, 
            (float)Math.Sin(angle) * dist 
        };

        var planet = new PlanetData {
            Id = id,
            Name = name,
            Position = pos,
            IsDiscovered = true,
            IsColonized = false
        };
        
        GameState.Planets.Add(planet);
        
        // Basic sphere model for planet
        var planetJson = await GeneratePlanetJson(name);
        await BabylonService.LoadModel(planetJson, pos, scale: 50.0f, id: id);
        
        // Notify
        // We don't have a notification system yet, but we'll see it in the console
    }

    private async Task<string> GeneratePlanetJson(string name)
    {
        // Simple procedural JSON for a large sphere
        return $@"{{
            ""Name"": ""{name}"",
            ""Type"": ""Planet"",
            ""Parts"": [
                {{
                    ""Id"": ""body"",
                    ""Shape"": ""Sphere"",
                    ""Position"": [0, 0, 0],
                    ""Rotation"": [0, 0, 0],
                    ""Scale"": [1, 1, 1],
                    ""ColorHex"": ""#4488ff"",
                    ""Material"": ""Standard""
                }},
                {{
                    ""Id"": ""atmosphere"",
                    ""Shape"": ""Sphere"",
                    ""Position"": [0, 0, 0],
                    ""Rotation"": [0, 0, 0],
                    ""Scale"": [1.05, 1.05, 1.05],
                    ""ColorHex"": ""#88ccff"",
                    ""Material"": ""Glass""
                }}
            ]
        }}";
    }

    private async Task HandleRadarLocationSelected(float[] worldPos)
    {
        if (!string.IsNullOrEmpty(_stationPendingTowId))
        {
            // NEW Autonomous Towing Flow
            var subPos = await BabylonService.GetModelPosition(_stationPendingTowId);
            if (subPos == null) return;

            // Find nearest idle tugboat
            string? nearestTugId = null;
            float minDistance = float.MaxValue;

            foreach (var shipId in GameState.Fleet)
            {
                if (GameState.ActiveMissions.TryGetValue(shipId, out var testMission))
                {
                    if (testMission.Type == GameUnitType.TugboatUnit && testMission.State == ShipState.Idle)
                    {
                        var shipPos = await BabylonService.GetModelPosition(shipId) ?? testMission.Position;
                        float dist = GetDistance(shipPos, subPos);
                        if (dist < minDistance)
                        {
                            minDistance = dist;
                            nearestTugId = shipId;
                        }
                    }
                }
            }

            if (nearestTugId != null)
            {
                var mission = GameState.ActiveMissions[nearestTugId];
                mission.State = ShipState.MovingToAsteroid;
                mission.AsteroidId = _stationPendingTowId;
                mission.AsteroidPosition = worldPos; // Final target
                
                var shipPos = await BabylonService.GetModelPosition(nearestTugId) ?? mission.Position;
                await BabylonService.MoveModel(nearestTugId, subPos, GetMoveDuration(shipPos, subPos, 20.0f));
                
                _stationPendingTowId = null;
                _noTugsAvailable = false;
            }
            else
            {
                _noTugsAvailable = true;
                _ = Task.Run(async () => { await Task.Delay(3000); _noTugsAvailable = false; StateHasChanged(); });
            }
            StateHasChanged();
        }
        else if (_isTowingMode && !string.IsNullOrEmpty(_selectedShipId) && !string.IsNullOrEmpty(_towingTargetId))
        {
            // LEGACY Manual Towing Flow (kept for compatibility or until fully removed)
            if (GameState.ActiveMissions.TryGetValue(_selectedShipId, out var mission))
            {
                mission.State = ShipState.MovingToAsteroid; 
                mission.AsteroidId = _towingTargetId;
                mission.AsteroidPosition = worldPos;
                
                var subPos = await BabylonService.GetModelPosition(_towingTargetId);
                if (subPos != null)
                {
                    var shipPos = await BabylonService.GetModelPosition(_selectedShipId) ?? mission.Position;
                    await BabylonService.MoveModel(_selectedShipId, subPos, GetMoveDuration(shipPos, subPos, 20.0f));
                }
                
                _isTowingMode = false;
                _towingTargetId = null;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void HandleInitiateStationTow(string id)
    {
        _stationPendingTowId = id;
        _selectedStationId = id;
        _selectedShipId = null;
        _isTowingMode = false;
        StateHasChanged();
    }

    private async Task HandleStartMission(string id)
    {
        if (GameState.ActiveMissions.TryGetValue(id, out var mission))
        {
            if (mission.Type == AstralExpanse.Services.GameUnitType.ScoutUnit)
            {
                mission.State = AstralExpanse.Services.ShipState.Scouting;
                var waypoint = GetRandomWaypoint(600, 1000);
                mission.CurrentTarget = waypoint;
                var shipPos = await BabylonService.GetModelPosition(id) ?? mission.Position;
                await BabylonService.MoveModel(id, waypoint, GetMoveDuration(shipPos, waypoint, 40.0f));
            }
            else if (mission.Type == AstralExpanse.Services.GameUnitType.FighterUnit)
            {
                mission.State = AstralExpanse.Services.ShipState.Patrolling;
                var waypoint = GetRandomWaypoint(150, 300);
                mission.CurrentTarget = waypoint;
                var shipPos = await BabylonService.GetModelPosition(id) ?? mission.Position;
                await BabylonService.MoveModel(id, waypoint, GetMoveDuration(shipPos, waypoint, 30.0f));
            }
            else if (mission.Type == GameUnitType.ColonyShipUnit)
            {
                var targetPlanet = GameState.Planets.FirstOrDefault(p => p.IsDiscovered && !p.IsColonized);
                if (targetPlanet != null)
                {
                    await StartColonizationMission(targetPlanet.Id);
                }
            }
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleSelectShipFromPanel(string id)
    {
        _selectedShipId = id;
        _selectedStationId = null;
        _selectedAsteroidId = null;
        await CenterOnObject(id);
        _showShipyard = false;
        _showMiningMenu = false;
        StateHasChanged();
    }

    private async Task HandleSelectStation(string id)
    {
        _selectedStationId = id;
        _selectedShipId = null;
        _selectedAsteroidId = null;
        await CenterOnObject(id);
        _showShipyard = false; 
        StateHasChanged();
    }

    private async Task CenterOnObject(string id)
    {
        await BabylonService.SetSelected(id);
        var pos = await BabylonService.GetModelPosition(id);
        if (pos != null)
        {
            await BabylonService.SetCameraTarget(pos[0], pos[1], pos[2]);
            _radar?.CenterOn(pos[0], pos[2]);
        }
    }

    private void HandleStopMining(string id)
    {
        if (GameState.ActiveMissions.TryGetValue(id, out var mission))
        {
            if (mission.Type == AstralExpanse.Services.GameUnitType.MinerUnit)
            {
                mission.StopRequested = true;
            }
            else
            {
                // For Scout/Fighter, stop immediately
                mission.State = AstralExpanse.Services.ShipState.Idle;
            }
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        GameState.OnStateChanged -= StateHasChanged;
        BabylonService.OnObjectClicked -= HandleObjectClicked;
        BabylonService.OnMoveComplete -= HandleMoveComplete;
        BabylonService.OnEscapePressed -= HandleEscape;
        _saveTimer?.Dispose();
    }

    private async Task VisitColony(string planetId)
    {
        _isSurfaceView = true;
        _currentSurfacePlanetId = planetId;
        _selectedShipId = null;
        _selectedAsteroidId = null;
        _selectedStationId = null;
        await BabylonService.SetSurfaceView(planetId);
        await InvokeAsync(StateHasChanged);
    }

    private async Task ExitSurfaceView()
    {
        _isSurfaceView = false;
        _currentSurfacePlanetId = null;
        await BabylonService.SetSpaceView();
        
        // Return camera to something sensible, like the Ark
        await CenterOnObject("Ark_Colonization_Station");
        await InvokeAsync(StateHasChanged);
    }
}

