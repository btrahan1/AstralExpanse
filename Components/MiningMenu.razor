@using AstralExpanse.Services
@inject GameStateService GameState

@if (Show)
{
    <div class="mining-menu" style="left: @(X)px; top: @(Y)px;">
        <div class="menu-item" @onclick="OnStartMining">
            <span class="icon">⛏️</span> Start Mining
        </div>
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public double X { get; set; }
    [Parameter] public double Y { get; set; }
    [Parameter] public EventCallback OnStartMining { get; set; }
}

<style>
    .mining-menu {
        position: fixed;
        background: rgba(10, 20, 40, 0.9);
        border: 1px solid #00ffcc;
        border-radius: 4px;
        color: white;
        padding: 5px;
        z-index: 200;
        cursor: pointer;
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        box-shadow: 0 0 15px rgba(0, 255, 204, 0.3);
    }

    .menu-item {
        padding: 8px 15px;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .menu-item:hover {
        background: rgba(0, 255, 204, 0.2);
    }

    .icon { font-size: 1.1rem; }
</style>
