@using AstralExpanse.Services
@inject BabylonService BabylonService
@implements IDisposable

<div class="radar-container">
    <div class="radar-frame">
        <svg viewBox="-105 -105 210 210" class="radar-svg">
            <!-- Background Rings -->
            <circle cx="0" cy="0" r="100" class="radar-bg" />
            <circle cx="0" cy="0" r="75" class="radar-ring" />
            <circle cx="0" cy="0" r="50" class="radar-ring" />
            <circle cx="0" cy="0" r="25" class="radar-ring" />
            
            <!-- Axis lines -->
            <line x1="-100" y1="0" x2="100" y2="0" class="radar-line" />
            <line x1="0" y1="-100" x2="0" y2="100" class="radar-line" />

            <!-- Radar Sweep -->
            <circle cx="0" cy="0" r="100" class="radar-sweep" />

            <!-- Entities -->
            @foreach (var entity in _entities)
            {
                var x = entity.Pos[0] * Scale;
                var z = entity.Pos[1] * Scale;
                
                // Only render if within circular bounds
                if (Math.Sqrt(x * x + z * z) <= 100)
                {
                    <circle cx="@x" cy="@z" r="@(GetSize(entity.Type))" class="marker @(GetClass(entity.Type).ToLower())">
                        <title>@entity.Name (@entity.Type)</title>
                    </circle>
                }
            }
        </svg>
        <div class="radar-label">TACTICAL RADAR</div>
    </div>
</div>

@code {
    private List<RadarEntity> _entities = new();
    private System.Timers.Timer? _timer;
    private const float Scale = 0.12f; // Maps ~800 units to ~100px

    protected override void OnInitialized()
    {
        _timer = new System.Timers.Timer(500);
        _timer.Elapsed += async (s, e) => {
            try {
                _entities = await BabylonService.GetRadarData();
                await InvokeAsync(StateHasChanged);
            } catch {
                // Ignore transient errors during disposal or init
            }
        };
        _timer.AutoReset = true;
        _timer.Enabled = true;
    }

    private float GetSize(string type) => type switch {
        "Station" => 4,
        "Ship" => 3,
        "Asteroid" => 1.5f,
        _ => 2
    };

    private string GetClass(string type) => type switch {
        "Station" => "station",
        "Ship" => "ship",
        "Asteroid" => "asteroid",
        _ => "other"
    };

    public void Dispose()
    {
        _timer?.Stop();
        _timer?.Dispose();
    }
}

<style>
    .radar-container {
        position: fixed;
        bottom: 20px;
        left: 20px;
        z-index: 20;
        pointer-events: none;
    }

    .radar-frame {
        position: relative;
        width: 180px;
        height: 180px;
        background: rgba(0, 0, 0, 0.4);
        border: 2px solid rgba(68, 136, 255, 0.5);
        border-radius: 50%;
        padding: 5px;
        backdrop-filter: blur(5px);
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.5), inset 0 0 15px rgba(68, 136, 255, 0.2);
    }

    .radar-svg {
        width: 100%;
        height: 100%;
        overflow: visible;
    }

    .radar-bg {
        fill: rgba(10, 20, 40, 0.6);
        stroke: none;
    }

    .radar-ring {
        fill: none;
        stroke: rgba(68, 136, 255, 0.2);
        stroke-width: 0.5;
    }

    .radar-line {
        stroke: rgba(68, 136, 255, 0.3);
        stroke-width: 0.5;
    }

    .radar-sweep {
        fill: none;
        stroke: rgba(68, 136, 255, 0.1);
        stroke-width: 100;
        stroke-dasharray: 0 314;
        animation: sweep 4s linear infinite;
        transform-origin: center;
        opacity: 0.3;
        pointer-events: none;
    }

    @@keyframes sweep {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    .marker {
        stroke-width: 1;
        pointer-events: auto;
    }

    .marker.station {
        fill: #ffffff;
        stroke: #4488ff;
        stroke-width: 2;
        filter: drop-shadow(0 0 4px #ffffff);
    }

    .marker.ship {
        fill: #00ffff;
        stroke: #ffffff;
        stroke-width: 1;
        filter: drop-shadow(0 0 3px #00ffff);
    }

    .marker.asteroid {
        fill: #aaaaaa;
        stroke: #444444;
        stroke-width: 0.5;
        opacity: 0.9;
        filter: drop-shadow(0 0 1px #888888);
    }

    .radar-label {
        position: absolute;
        bottom: -20px;
        left: 50%;
        transform: translateX(-50%);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        font-size: 0.65rem;
        color: #4488ff;
        letter-spacing: 2px;
        text-transform: uppercase;
        font-weight: bold;
        text-shadow: 0 0 5px rgba(0,0,0,0.8);
    }
</style>
