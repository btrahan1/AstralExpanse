@using AstralExpanse.Services
@inject BabylonService BabylonService
@implements IDisposable

@if (Visible)
{
    <div class="radar-container">
        <div class="radar-frame">
            <div class="radar-click-surface" @onclick="HandleRadarClick">
                <svg viewBox="-105 -105 210 210" class="radar-svg">
                    <!-- Background Rings -->
                    <circle cx="0" cy="0" r="100" class="radar-bg" />
                    <circle cx="0" cy="0" r="75" class="radar-ring" />
                    <circle cx="0" cy="0" r="50" class="radar-ring" />
                    <circle cx="0" cy="0" r="25" class="radar-ring" />
                    
                    <!-- Axis lines -->
                    <line x1="-100" y1="0" x2="100" y2="0" class="radar-line" />
                    <line x1="0" y1="-100" x2="0" y2="100" class="radar-line" />

                    <!-- Radar Sweep -->
                    <circle cx="0" cy="0" r="100" class="radar-sweep" />

                    <!-- Entities -->
                    @foreach (var entity in _entities)
                    {
                        var x = (entity.Pos[0] - _radarCenterX) * Scale;
                        var z = (entity.Pos[1] - _radarCenterZ) * Scale;
                        
                        // Only render if within circular bounds
                        if (Math.Sqrt(x * x + z * z) <= 100)
                        {
                            <circle cx="@x" cy="@z" r="@(GetSize(entity.Type))" class="marker @(GetClass(entity.Type).ToLower())">
                                <title>@entity.Name (@entity.Type)</title>
                            </circle>
                        }
                    }
                </svg>
            </div>
            <div class="radar-label">TACTICAL RADAR</div>
            
            <button class="home-button" @onclick="ResetToHome" title="Reset to Ark Station">
                <svg viewBox="0 0 24 24" width="16" height="16">
                    <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" fill="currentColor"/>
                </svg>
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; } = true;
    [Parameter] public bool IsPlanetaryView { get; set; } = false;
    [Parameter] public EventCallback<float[]> OnLocationSelected { get; set; }

    private List<RadarEntity> _entities = new();
    private System.Timers.Timer? _timer;
    private float Scale => IsPlanetaryView ? 0.15f : 0.12f; 
    private float _radarCenterX = 0;
    private float _radarCenterZ = 0;

    protected override void OnInitialized()
    {
        _timer = new System.Timers.Timer(500);
        _timer.Elapsed += async (s, e) => {
            try {
                var data = await BabylonService.GetRadarData();
                _entities = data.Entities;
                
                if (IsPlanetaryView && data.Center != null)
                {
                    _radarCenterX = data.Center[0];
                    _radarCenterZ = data.Center[1];
                }
                
                await InvokeAsync(StateHasChanged);
            } catch {
                // Ignore transient errors during disposal or init
            }
        };
        _timer.AutoReset = true;
        _timer.Enabled = true;
    }

    public void CenterOn(float x, float z)
    {
        _radarCenterX = x;
        _radarCenterZ = z;
        StateHasChanged();
    }

    private async Task HandleRadarClick(MouseEventArgs e)
    {
        // 180px is the element width/height. Center is 90,90.
        // viewBox is 210 wide.
        var relX = e.OffsetX - 90;
        var relZ = e.OffsetY - 90;
        
        var svgX = relX * (210.0 / 180.0);
        var svgZ = relZ * (210.0 / 180.0);
        
        // Calculate the world delta from the current center
        var deltaX = (float)(svgX / Scale);
        var deltaZ = (float)(svgZ / Scale);
        
        // Update new absolute world coordinates
        _radarCenterX += deltaX;
        _radarCenterZ += deltaZ;
        
        await OnLocationSelected.InvokeAsync(new float[] { _radarCenterX, 0, _radarCenterZ });
        await BabylonService.SetCameraTarget(_radarCenterX, 0, _radarCenterZ);
        StateHasChanged();
    }

    private async Task ResetToHome()
    {
        _radarCenterX = 0;
        _radarCenterZ = 0;
        await BabylonService.SetCameraTarget(0, 0, 0);
        StateHasChanged();
    }

    private float GetSize(string type) => type switch {
        "Station" => 4,
        "SubStation" => 3,
        "Ship" => 2,
        "SurfaceMiner" => 2,
        "Rover" => 2.5f,
        "Asteroid" => 1.5f,
        "Monolith" => 3,
        "Building" => 1.5f,
        _ => 1.5f
    };

    private string GetClass(string type) => type switch {
        "Station" => "station",
        "SubStation" => "substation",
        "Ship" => "ship",
        "SurfaceMiner" => "ship",
        "Rover" => "ship",
        "Asteroid" => "asteroid",
        "Monolith" => "asteroid",
        "Building" => "building",
        _ => "other"
    };

    public void Dispose()
    {
        _timer?.Stop();
        _timer?.Dispose();
    }
}

<style>
    .radar-container {
        position: fixed;
        bottom: 20px;
        left: 20px;
        z-index: 20;
        pointer-events: none;
    }

    .radar-frame {
        position: relative;
        width: 360px;
        height: 360px;
        background: rgba(0, 0, 0, 0.4);
        border: 2px solid rgba(68, 136, 255, 0.5);
        border-radius: 50%;
        padding: 5px;
        backdrop-filter: blur(5px);
        box-shadow: 0 0 20px rgba(0, 0, 0, 0.5), inset 0 0 15px rgba(68, 136, 255, 0.2);
        pointer-events: auto;
        cursor: crosshair;
    }

    .radar-click-surface {
        width: 100%;
        height: 100%;
        pointer-events: auto;
        cursor: crosshair;
    }

    .radar-svg {
        width: 100%;
        height: 100%;
        overflow: visible;
        pointer-events: none;
    }

    .radar-bg {
        fill: rgba(5, 10, 20, 0.9);
        stroke: rgba(68, 136, 255, 0.5);
        stroke-width: 1;
    }

    .radar-ring {
        fill: none;
        stroke: rgba(68, 136, 255, 0.2);
        stroke-width: 0.5;
    }

    .radar-line {
        stroke: rgba(68, 136, 255, 0.3);
        stroke-width: 0.5;
    }

    .radar-sweep {
        fill: none;
        stroke: rgba(68, 136, 255, 0.3);
        stroke-width: 125;
        stroke-dasharray: 0 314;
        animation: sweep 4s linear infinite;
        transform-origin: center;
        opacity: 0.2;
        pointer-events: none;
        filter: blur(2px);
    }

    @@keyframes sweep {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }

    .marker {
        stroke-width: 1;
        pointer-events: none;
        fill: #666;
    }

    .marker.station {
        fill: #ffffff;
        stroke: #4488ff;
        stroke-width: 2;
        filter: drop-shadow(0 0 4px #ffffff);
    }

    .marker.substation {
        fill: #C0C0C0;
        stroke: #4488ff;
        stroke-width: 1.5;
        filter: drop-shadow(0 0 3px #C0C0C0);
    }

    .marker.ship {
        fill: #00ffff;
        stroke: #ffffff;
        stroke-width: 1;
        filter: drop-shadow(0 0 3px #00ffff);
    }

    .marker.asteroid {
        fill: #aaaaaa;
        stroke: #444444;
        stroke-width: 0.5;
        opacity: 0.9;
        filter: drop-shadow(0 0 1px #888888);
    }

    .marker.building {
        fill: #4488ff;
        stroke: #ffffff;
        stroke-width: 0.8;
        opacity: 0.9;
        filter: drop-shadow(0 0 2px rgba(68,136,255,0.5));
    }

    .radar-label {
        position: absolute;
        bottom: -25px;
        left: 50%;
        transform: translateX(-50%);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        font-size: 0.8rem;
        color: #4488ff;
        letter-spacing: 2px;
        text-transform: uppercase;
        font-weight: bold;
        text-shadow: 0 0 5px rgba(0,0,0,0.8);
    }

    .home-button {
        position: absolute;
        top: 0;
        right: -30px;
        width: 24px;
        height: 24px;
        background: rgba(10, 20, 40, 0.8);
        border: 1px solid rgba(68, 136, 255, 0.5);
        border-radius: 4px;
        color: #4488ff;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        pointer-events: auto;
        transition: all 0.2s;
        backdrop-filter: blur(5px);
        padding: 0;
    }

    .home-button:hover {
        background: rgba(68, 136, 255, 0.2);
        color: #ffffff;
        box-shadow: 0 0 10px rgba(68, 136, 255, 0.4);
    }

    .home-button svg {
        pointer-events: none;
    }
</style>
