@using AstralExpanse.Services
@inject GameStateService GameState
@implements IDisposable

<div class="stats-bar">
    <div class="stat-item aether">AETHER: <strong>@GameState.AetherShards</strong></div>
    <div class="stat-item ore">ORE: <strong>@GameState.Ore</strong></div>
    <div class="stat-item wheat">WHEAT: <strong>@GameState.Wheat</strong></div>
    <div class="stat-item potato">POTATO: <strong>@GameState.Potato</strong></div>
    <div class="stat-item corn">CORN: <strong>@GameState.Corn</strong></div>
    <div class="stat-item population">POPULATION: <strong>@GameState.TotalPopulation</strong></div>
</div>

@code {
    protected override void OnInitialized()
    {
        GameState.OnStateChanged += StateHasChanged;
    }

    public void Dispose()
    {
        GameState.OnStateChanged -= StateHasChanged;
    }
}

<style>
    .stats-bar { 
        display: flex;
        gap: 15px;
        background: rgba(0, 0, 0, 0.4);
        padding: 5px 15px;
        border-radius: 20px;
        border: 1px solid rgba(68, 136, 255, 0.3);
        backdrop-filter: blur(5px);
        margin-top: 10px;
        pointer-events: auto;
    }
    .stat-item {
        font-size: 0.75rem;
        font-weight: bold;
        letter-spacing: 1px;
    }
    .stat-item.aether { color: #00ffff; }
    .stat-item.ore { color: #ffcc00; }
    .stat-item.wheat { color: #eedd88; }
    .stat-item.potato { color: #aaaaaa; }
    .stat-item.corn { color: #ffdd00; }
    .stat-item.population { color: #88ff88; }
    .stat-item strong { 
        color: #fff;
        margin-left: 5px;
    }
</style>
