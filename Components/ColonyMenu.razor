@using AstralExpanse.Services
@inject ColonyService Colony
@inject GameStateService GameState
@inject BabylonService Babylon

@if (Show)
{
    <div class="colony-menu">
        <div class="menu-header">
            <h3>PLANETARY COLONY</h3>
            <button class="close-btn" @onclick="OnClose">&times;</button>
        </div>
        
        <div class="resource-panel">
            <div class="res-item">ORE: @GameState.Ore</div>
            <div class="res-item wheat">WHEAT: @GameState.Wheat</div>
            <div class="res-item potato">POTATO: @GameState.Potato</div>
            <div class="res-item corn">CORN: @GameState.Corn</div>
        </div>

        @if (Colony.IsPlacing)
        {
            <div class="placement-state">
                <p>SELECT LOCATION ON SURFACE</p>
                <button class="cancel-btn" @onclick="Colony.CancelPlacement">CANCEL</button>
            </div>
        }
        else
        {
            <div class="buildings-list">
                <div class="section-header">STRUCTURES</div>
                <div class="building-item">
                    <div class="info">
                        <strong>Tech Farmhouse</strong>
                        <p>Increases sustainable population.</p>
                    </div>
                    <button class="build-btn" @onclick='() => Build("FarmHouse")' disabled="@(GameState.Ore < 500)">
                        BUILD (500)
                    </button>
                </div>

                <div class="building-item">
                    <div class="info">
                        <strong>Research Center</strong>
                        <p>Generates tech points for upgrades.</p>
                    </div>
                    <button class="build-btn" @onclick='() => Build("ResearchCenter")' disabled="@(GameState.Ore < 1200)">
                        BUILD (1200)
                    </button>
                </div>

                @{
                    var planet = GameState.Planets.Find(p => p.Id == PlanetId);
                    bool hasFarmhouse = planet?.Buildings.Any(b => b.Type == "FarmHouse") ?? false;
                }
                <div class="building-item">
                    <div class="info">
                        <strong>Farming Bot</strong>
                        <p>Autonomous drone for field maintenance.</p>
                    </div>
                    <button class="build-btn" @onclick='() => BuildBot()' disabled="@(GameState.Ore < 300 || !hasFarmhouse)">
                        BUILD (300)
                    </button>
                </div>

                @if (planet != null && planet.Bots.Any())
                {
                    <div class="section-header">BOT STATUS</div>
                    <div class="bot-status-list">
                        @foreach (var bot in planet.Bots)
                        {
                            <div class="bot-item">
                                <div class="bot-info">
                                    <span class="bot-id">@bot.Id.Split('_').Last()</span>
                                    <button class="locate-btn" @onclick='() => Locate(bot.Id)'>LOCATE</button>
                                    <span class="bot-phase">@(bot.IsTraveling ? "Traveling..." : bot.CurrentPhase)</span>
                                </div>
                                <div class="progress-bg">
                                    @if (!bot.IsTraveling)
                                    {
                                        <div class="progress-fill" style="width: @(bot.PhaseProgress * 100)%"></div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }

                <div class="section-header">AGRICULTURE</div>
                <div class="building-item">
                    <div class="info">
                        <strong>Wheat Field</strong>
                        <p>Basic grain crop.</p>
                    </div>
                    <button class="build-btn" @onclick='() => Build("WheatField")' disabled="@(GameState.Ore < 100)">
                        PLANT (100)
                    </button>
                </div>

                <div class="building-item">
                    <div class="info">
                        <strong>Potato Field</strong>
                        <p>Hardy tubers, high yield.</p>
                    </div>
                    <button class="build-btn" @onclick='() => Build("PotatoField")' disabled="@(GameState.Ore < 150)">
                        PLANT (150)
                    </button>
                </div>

                <div class="building-item">
                    <div class="info">
                        <strong>Corn Field</strong>
                        <p>Premium crop for biofuel/food.</p>
                    </div>
                    <button class="build-btn" @onclick='() => Build("CornField")' disabled="@(GameState.Ore < 200)">
                        PLANT (200)
                    </button>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public string? PlanetId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task Build(string type)
    {
        if (string.IsNullOrEmpty(PlanetId)) return;
        await Colony.BuildBuilding(PlanetId, type);
    }

    private async Task BuildBot()
    {
        if (string.IsNullOrEmpty(PlanetId)) return;
        await Colony.BuildFarmingBot(PlanetId);
    }

    private async Task Locate(string botId)
    {
        await Babylon.SetCameraTarget(0, 0, 0); // Temporary reset if needed
        var pos = GameState.Planets.Find(p => p.Id == PlanetId)?.Bots.Find(b => b.Id == botId)?.Position;
        if (pos != null)
        {
            await Babylon.SetCameraTarget(pos[0], pos[1] + 10, pos[2]);
            await Babylon.SetSelected(botId);
        }
    }
}

<style>
    .colony-menu {
        position: fixed;
        right: 40px;
        top: 100px;
        width: 320px;
        background: rgba(20, 30, 40, 0.95);
        border: 2px solid #4488ff;
        border-radius: 12px;
        padding: 20px;
        color: white;
        backdrop-filter: blur(15px);
        box-shadow: 0 0 30px rgba(0, 0, 0, 0.5), inset 0 0 10px rgba(68, 136, 255, 0.2);
        z-index: 1000;
        animation: slideIn 0.3s ease-out;
    }

    @@keyframes slideIn {
        from { transform: translateX(100%); opacity: 0; }
        to { transform: translateX(0); opacity: 1; }
    }

    .menu-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(68, 136, 255, 0.3);
        padding-bottom: 10px;
        margin-bottom: 15px;
    }

    .menu-header h3 {
        margin: 0;
        font-size: 1.2rem;
        letter-spacing: 1px;
        color: #88ccff;
    }

    .close-btn {
        background: none;
        border: none;
        color: #88ccff;
        font-size: 1.5rem;
        cursor: pointer;
    }

    .resource-panel {
        background: rgba(0, 0, 0, 0.3);
        padding: 10px;
        border-radius: 8px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        margin-bottom: 20px;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }

    .res-item {
        font-size: 0.75rem;
        font-weight: bold;
        color: #ffcc00;
        text-align: center;
    }

    .res-item.wheat { color: #eedd88; }
    .res-item.potato { color: #aaaaaa; }
    .res-item.corn { color: #ffdd00; }

    .section-header {
        font-size: 0.7rem;
        font-weight: bold;
        color: #4488ff;
        letter-spacing: 2px;
        margin-bottom: 10px;
        margin-top: 10px;
        border-left: 3px solid #4488ff;
        padding-left: 8px;
    }

    .building-item {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        padding: 12px;
        margin-bottom: 15px;
        transition: background 0.2s;
    }

    .building-item:hover {
        background: rgba(255, 255, 255, 0.08);
    }

    .placement-state {
        background: rgba(68, 136, 255, 0.1);
        border: 1px dashed #4488ff;
        padding: 15px;
        border-radius: 8px;
        text-align: center;
        margin-bottom: 20px;
        animation: pulse 2s infinite;
    }

    .placement-state p {
        font-size: 0.85rem;
        color: #88ccff;
        margin-bottom: 10px;
        font-weight: bold;
        letter-spacing: 1px;
    }

    @@keyframes pulse {
        0% { border-color: rgba(68, 136, 255, 0.3); box-shadow: 0 0 5px rgba(68, 136, 255, 0.2); }
        50% { border-color: rgba(68, 136, 255, 1); box-shadow: 0 0 15px rgba(68, 136, 255, 0.4); }
        100% { border-color: rgba(68, 136, 255, 0.3); box-shadow: 0 0 5px rgba(68, 136, 255, 0.2); }
    }

    .cancel-btn {
        width: 100%;
        background: rgba(255, 68, 68, 0.2);
        border: 1px solid #ff4444;
        color: #ff6666;
        padding: 6px;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.2s;
    }

    .cancel-btn:hover {
        background: #ff4444;
        color: white;
    }

    .info strong {
        display: block;
        margin-bottom: 4px;
        color: #ffffff;
    }

    .info p {
        margin: 0;
        font-size: 0.85rem;
        color: #aaaaaa;
        margin-bottom: 12px;
    }

    .build-btn {
        width: 100%;
        background: #4488ff;
        border: none;
        color: white;
        padding: 8px;
        border-radius: 4px;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.2s;
    }

    .build-btn:hover:not(:disabled) {
        background: #66aaff;
        transform: translateY(-2px);
    }

    .build-btn:disabled {
        background: #444;
        color: #777;
        cursor: not-allowed;
    }

    .bot-status-list {
        margin-bottom: 20px;
    }

    .bot-item {
        background: rgba(0, 0, 0, 0.2);
        border: 1px solid rgba(68, 136, 255, 0.2);
        padding: 10px;
        border-radius: 6px;
        margin-bottom: 8px;
    }

    .bot-info {
        display: flex;
        justify-content: space-between;
        font-size: 0.7rem;
        font-weight: bold;
        margin-bottom: 6px;
        color: #88ccff;
    }

    .bot-id { color: #aaaaaa; }

    .progress-bg {
        height: 4px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 2px;
        overflow: hidden;
    }

    .progress-fill {
        height: 100%;
        background: #4488ff;
        box-shadow: 0 0 10px #4488ff;
        transition: width 1s linear;
    }

    .locate-btn {
        background: rgba(68, 136, 255, 0.3);
        border: 1px solid #4488ff;
        color: #fff;
        font-size: 0.5rem;
        padding: 2px 6px;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.2s;
    }

    .locate-btn:hover {
        background: #4488ff;
    }
</style>
