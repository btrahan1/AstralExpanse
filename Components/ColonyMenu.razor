@using AstralExpanse.Services
@inject ColonyService Colony
@inject GameStateService GameState

@if (Show)
{
    <div class="colony-menu">
        <div class="menu-header">
            <h3>PLANETARY COLONY</h3>
            <button class="close-btn" @onclick="OnClose">&times;</button>
        </div>
        
        <div class="ore-status">
            ORE: @GameState.Ore
        </div>

        @if (Colony.IsPlacing)
        {
            <div class="placement-state">
                <p>SELECT LOCATION ON SURFACE</p>
                <button class="cancel-btn" @onclick="Colony.CancelPlacement">CANCEL</button>
            </div>
        }
        else
        {
            <div class="buildings-list">
                <div class="building-item">
                    <div class="info">
                        <strong>Tech Farmhouse</strong>
                        <p>Increases sustainable population.</p>
                    </div>
                    <button class="build-btn" @onclick='() => Build("FarmHouse")' disabled="@(GameState.Ore < 500)">
                        BUILD (500)
                    </button>
                </div>

                <div class="building-item">
                    <div class="info">
                        <strong>Research Center</strong>
                        <p>Generates tech points for upgrades.</p>
                    </div>
                    <button class="build-btn" @onclick='() => Build("ResearchCenter")' disabled="@(GameState.Ore < 1200)">
                        BUILD (1200)
                    </button>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public string? PlanetId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private async Task Build(string type)
    {
        if (string.IsNullOrEmpty(PlanetId)) return;
        await Colony.BuildBuilding(PlanetId, type);
    }
}

<style>
    .colony-menu {
        position: fixed;
        right: 40px;
        top: 100px;
        width: 320px;
        background: rgba(20, 30, 40, 0.95);
        border: 2px solid #4488ff;
        border-radius: 12px;
        padding: 20px;
        color: white;
        backdrop-filter: blur(15px);
        box-shadow: 0 0 30px rgba(0, 0, 0, 0.5), inset 0 0 10px rgba(68, 136, 255, 0.2);
        z-index: 1000;
        animation: slideIn 0.3s ease-out;
    }

    @@keyframes slideIn {
        from { transform: translateX(100%); opacity: 0; }
        to { transform: translateX(0); opacity: 1; }
    }

    .menu-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(68, 136, 255, 0.3);
        padding-bottom: 10px;
        margin-bottom: 15px;
    }

    .menu-header h3 {
        margin: 0;
        font-size: 1.2rem;
        letter-spacing: 1px;
        color: #88ccff;
    }

    .close-btn {
        background: none;
        border: none;
        color: #88ccff;
        font-size: 1.5rem;
        cursor: pointer;
    }

    .ore-status {
        background: rgba(0, 0, 0, 0.3);
        padding: 8px;
        border-radius: 6px;
        text-align: center;
        font-weight: bold;
        color: #ffcc00;
        margin-bottom: 20px;
        border: 1px solid rgba(255, 204, 0, 0.2);
    }

    .building-item {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        padding: 12px;
        margin-bottom: 15px;
        transition: background 0.2s;
    }

    .building-item:hover {
        background: rgba(255, 255, 255, 0.08);
    }

    .placement-state {
        background: rgba(68, 136, 255, 0.1);
        border: 1px dashed #4488ff;
        padding: 15px;
        border-radius: 8px;
        text-align: center;
        margin-bottom: 20px;
        animation: pulse 2s infinite;
    }

    .placement-state p {
        font-size: 0.85rem;
        color: #88ccff;
        margin-bottom: 10px;
        font-weight: bold;
        letter-spacing: 1px;
    }

    @@keyframes pulse {
        0% { border-color: rgba(68, 136, 255, 0.3); box-shadow: 0 0 5px rgba(68, 136, 255, 0.2); }
        50% { border-color: rgba(68, 136, 255, 1); box-shadow: 0 0 15px rgba(68, 136, 255, 0.4); }
        100% { border-color: rgba(68, 136, 255, 0.3); box-shadow: 0 0 5px rgba(68, 136, 255, 0.2); }
    }

    .cancel-btn {
        width: 100%;
        background: rgba(255, 68, 68, 0.2);
        border: 1px solid #ff4444;
        color: #ff6666;
        padding: 6px;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.2s;
    }

    .cancel-btn:hover {
        background: #ff4444;
        color: white;
    }

    .info strong {
        display: block;
        margin-bottom: 4px;
        color: #ffffff;
    }

    .info p {
        margin: 0;
        font-size: 0.85rem;
        color: #aaaaaa;
        margin-bottom: 12px;
    }

    .build-btn {
        width: 100%;
        background: #4488ff;
        border: none;
        color: white;
        padding: 8px;
        border-radius: 4px;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.2s;
    }

    .build-btn:hover:not(:disabled) {
        background: #66aaff;
        transform: translateY(-2px);
    }

    .build-btn:disabled {
        background: #444;
        color: #777;
        cursor: not-allowed;
    }
</style>
