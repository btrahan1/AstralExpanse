@using AstralExpanse.Services
@inject GameStateService GameState

@if (Visible)
{
    <div class="fleet-panel">
    <h3>Fleet Command</h3>
    <div class="ship-list">
        @if (!GameState.Stations.Any())
        {
            <div class="empty-fleet">No command hubs detected.</div>
        }
        else
        {
            @foreach (var stationId in GameState.Stations)
            {
                var stationName = stationId == "Ark_Colonization_Station" ? "Ark Station (Home)" : $"SubStation {stationId.Split('_')[2]}";
                var isCollapsed = _collapsedStations.Contains(stationId);
                var stationShips = GameState.ActiveMissions.Values.Where(m => m.ParentStationId == stationId).ToList();

                <div class="station-group">
                    <div class="station-group-header" @onclick="() => ToggleStation(stationId)">
                        <span class="collapse-icon">@(isCollapsed ? "▶" : "▼")</span>
                        <span class="station-group-name">@stationName</span>
                        <span class="ship-count">@stationShips.Count</span>
                    </div>

                    @if (!isCollapsed)
                    {
                        <div class="station-group-content">
                            @if (!stationShips.Any())
                            {
                                <div class="empty-group">No ships assigned.</div>
                            }
                            else
                            {
                                @foreach (var mission in stationShips)
                                {
                                    var shipId = mission.ShipId;
                                    var isSelected = shipId == SelectedShipId;
                                    var status = mission.State.ToString();
                                    var stopRequested = mission.StopRequested;
                                    <div class="ship-item @(isSelected ? "selected" : "")" @onclick="() => SelectShip(shipId)">
                                        <div class="ship-info">
                                            <span class="ship-name">@mission.Type.ToString() @(shipId.Split('_')[^1])</span>
                                            @{
                                                var displayStatus = status;
                                                if (status == "MovingToAsteroid" && mission.AsteroidId.StartsWith("Planet_")) displayStatus = "MovingToPlanet";
                                            }
                                            <span class="ship-status @displayStatus.ToLower()">@displayStatus @(stopRequested ? "(Stopping)" : "")</span>
                                        </div>
                                        @if (mission.State == ShipState.Mining || mission.State == ShipState.Unloading)
                                        {
                                            <div class="cargo-container">
                                                <div class="cargo-bar" style="width: @(mission.Cargo)%"></div>
                                                <span class="cargo-text">@(mission.Cargo)%</span>
                                            </div>
                                        }
                                        else if (mission.State == ShipState.Building)
                                        {
                                            <div class="cargo-container construction">
                                                <div class="cargo-bar construction-bar" style="width: @(mission.ConstructionProgress)%"></div>
                                                <span class="cargo-text construction-text">@(((int)mission.ConstructionProgress))%</span>
                                            </div>
                                        }
                                        <div class="ship-actions">
                                            @if (mission.State == ShipState.Idle)
                                            {
                                                @if (mission.Type == GameUnitType.ScoutUnit)
                                                {
                                                    <button class="btn-action scout" @onclick:stopPropagation="true" @onclick="() => StartMission(shipId)">Scout</button>
                                                }
                                                else if (mission.Type == GameUnitType.FighterUnit)
                                                {
                                                    <button class="btn-action patrol" @onclick:stopPropagation="true" @onclick="() => StartMission(shipId)">Patrol</button>
                                                }
                                                else if (mission.Type == GameUnitType.ColonyShipUnit && GameState.Planets.Any(p => p.IsDiscovered && !p.IsColonized))
                                                {
                                                    <button class="btn-action colony-btn" @onclick:stopPropagation="true" @onclick="() => StartMission(shipId)">Colonize Planet</button>
                                                }
                                            }
                                            else if (mission.State != ShipState.Idle && !stopRequested)
                                            {
                                                <button class="btn-stop" @onclick:stopPropagation="true" @onclick="() => StopMining(shipId)">Stop</button>
                                            }
                                        </div>
                                    </div>
                                }
                            }
                        </div>
                    }
                </div>
            }
        }
    </div>

    @if (GameState.Planets.Any(p => p.IsDiscovered))
    {
        <h3>Planets & Colonies</h3>
        <div class="planet-list">
            @foreach (var planet in GameState.Planets.Where(p => p.IsDiscovered))
            {
                <div class="planet-item" @onclick="() => SelectPlanet(planet.Id)">
                    <div class="ship-info">
                        <span class="ship-name">@planet.Name</span>
                        <span class="ship-status @(planet.IsColonized ? "scouting" : "building")">
                            @(planet.IsColonized ? "COLONIZED" : "Habitable")
                        </span>
                    </div>
                    @if (planet.IsColonized)
                    {
                        <div class="ship-actions">
                            <button class="btn-action visit-btn" @onclick:stopPropagation="true" @onclick="() => OnVisitPlanet.InvokeAsync(planet.Id)">VISIT</button>
                        </div>
                    }
                </div>
            }
        </div>
    }
    </div>
}

@code {
    [Parameter] public bool Visible { get; set; } = true;
    [Parameter] public string? SelectedShipId { get; set; }
    [Parameter] public EventCallback<string> OnSelectShip { get; set; }
    [Parameter] public EventCallback<string> OnVisitPlanet { get; set; }
    [Parameter] public EventCallback<string> OnStopMining { get; set; }
    [Parameter] public EventCallback<string> OnStartMission { get; set; }
    [Parameter] public EventCallback<string> OnInitiateTow { get; set; }

    private HashSet<string> _collapsedStations = new HashSet<string>();

    private void ToggleStation(string id)
    {
        if (_collapsedStations.Contains(id)) _collapsedStations.Remove(id);
        else _collapsedStations.Add(id);
    }

    private async Task SelectShip(string id)
    {
        await OnSelectShip.InvokeAsync(id);
    }

    private async Task StopMining(string id)
    {
        await OnStopMining.InvokeAsync(id);
    }

    private async Task StartMission(string id)
    {
        await OnStartMission.InvokeAsync(id);
    }

    private async Task InitiateTow(string id)
    {
        await OnInitiateTow.InvokeAsync(id);
    }

    private async Task SelectPlanet(string id)
    {
        // Just center on it in space view
        await OnSelectShip.InvokeAsync(id);
    }
}

<style>
    .fleet-panel {
        position: fixed;
        top: 20px;
        right: 20px;
        width: 280px;
        max-height: 400px;
        background: rgba(16, 24, 48, 0.85);
        backdrop-filter: blur(15px);
        border: 1px solid rgba(68, 136, 255, 0.3);
        border-radius: 12px;
        padding: 15px;
        color: white;
        z-index: 20;
        display: flex;
        flex-direction: column;
        box-shadow: 0 10px 30px rgba(0,0,0,0.5);
    }

    h3 {
        margin: 0 0 15px 0;
        font-weight: 300;
        letter-spacing: 2px;
        text-transform: uppercase;
        font-size: 0.9rem;
        border-bottom: 1px solid rgba(255,255,255,0.1);
        padding-bottom: 10px;
        color: #4488ff;
    }

    .ship-list {
        overflow-y: auto;
        flex-grow: 1;
        padding-right: 5px;
    }

    .ship-list::-webkit-scrollbar {
        width: 4px;
    }
    .ship-list::-webkit-scrollbar-thumb {
        background: rgba(68, 136, 255, 0.5);
        border-radius: 4px;
    }

    .empty-fleet {
        padding: 20px;
        text-align: center;
        color: #888;
        font-style: italic;
        font-size: 0.8rem;
    }

    .station-group {
        margin-bottom: 12px;
        background: rgba(255, 255, 255, 0.03);
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .station-group-header {
        background: rgba(68, 136, 255, 0.1);
        padding: 8px 12px;
        display: flex;
        align-items: center;
        cursor: pointer;
        transition: background 0.2s;
        border-bottom: 1px solid rgba(68, 136, 255, 0.1);
    }

    .station-group-header:hover {
        background: rgba(68, 136, 255, 0.2);
    }

    .collapse-icon {
        font-size: 0.6rem;
        margin-right: 8px;
        color: #4488ff;
        width: 10px;
    }

    .station-group-name {
        font-size: 0.75rem;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 1px;
        flex-grow: 1;
        color: #88ccff;
    }

    .ship-count {
        font-size: 0.65rem;
        background: rgba(255, 255, 255, 0.1);
        padding: 2px 6px;
        border-radius: 10px;
        color: #888;
    }

    .station-group-content {
        padding: 8px;
    }

    .empty-group {
        font-size: 0.7rem;
        color: #666;
        text-align: center;
        padding: 10px;
    }

    .ship-item {
        background: rgba(255,255,255,0.05);
        border: 1px solid rgba(255,255,255,0.1);
        border-radius: 8px;
        padding: 10px;
        margin-bottom: 6px;
        cursor: pointer;
        transition: all 0.2s;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .ship-item:hover {
        background: rgba(68, 136, 255, 0.15);
        border-color: rgba(68, 136, 255, 0.4);
    }

    .ship-item.selected {
        background: rgba(68, 136, 255, 0.25);
        border-color: #4488ff;
        box-shadow: 0 0 10px rgba(68, 136, 255, 0.3);
    }

    .ship-info {
        display: flex;
        flex-direction: column;
    }

    .ship-name {
        font-weight: 600;
        font-size: 0.85rem;
    }

    .ship-status {
        font-size: 0.7rem;
        color: #888;
        margin-top: 2px;
    }

    .ship-status.mining { color: #00ffcc; }
    .ship-status.movingtoasteroid { color: #ffcc00; }
    .ship-status.movingtoplanet { color: #4488ff; font-weight: bold; }
    .ship-status.returningtostation { color: #4488ff; }
    .ship-status.droppingoff { color: #ff4488; }
    .ship-status.scouting { color: #00ff00; }
    .ship-status.patrolling { color: #ff8800; }
    .ship-status.towing { color: #ffcc00; }
    .ship-status.unloading { color: #ff4488; }
    .ship-status.building { color: #ffcc00; font-weight: bold; }
    .ship-status.searching { color: #00ffff; font-style: italic; }
    .ship-status.colonizing { color: #ffffff; text-shadow: 0 0 5px #fff; }

    .cargo-container {
        flex-grow: 1;
        margin: 0 15px;
        height: 8px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 4px;
        position: relative;
        overflow: hidden;
        border: 1px solid rgba(255, 255, 255, 0.05);
    }

    .cargo-bar {
        height: 100%;
        background: linear-gradient(90deg, #00ffcc, #00ccff);
        box-shadow: 0 0 10px rgba(0, 255, 204, 0.5);
        transition: width 0.3s ease-out;
    }

    .cargo-text {
        position: absolute;
        top: -12px;
        left: 50%;
        transform: translateX(-50%);
        font-size: 0.6rem;
        color: #00ffcc;
        font-weight: bold;
    }

    .cargo-container.construction {
        border-color: rgba(255, 204, 0, 0.3);
    }
    
    .construction-bar {
        background: linear-gradient(90deg, #ffcc00, #ff8800) !important;
        box-shadow: 0 0 10px rgba(255, 204, 0, 0.5) !important;
    }

    .construction-text {
        color: #ffcc00 !important;
    }

    .btn-stop {
        background: rgba(255, 68, 68, 0.2);
        border: 1px solid rgba(255, 68, 68, 0.4);
        color: #ff6666;
        font-size: 0.7rem;
        padding: 3px 8px;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-stop:hover {
        background: rgba(255, 68, 68, 0.4);
        color: white;
    }

    .btn-action {
        font-size: 0.7rem;
        padding: 3px 8px;
        border-radius: 4px;
        cursor: pointer;
        transition: all 0.2s;
        border: 1px solid rgba(255, 255, 255, 0.2);
        background: rgba(255, 255, 255, 0.1);
        color: white;
    }

    .btn-action.scout {
        border-color: rgba(0, 255, 0, 0.4);
        color: #00ff00;
        background: rgba(0, 255, 0, 0.1);
    }

    .btn-action.patrol {
        border-color: rgba(255, 136, 0, 0.4);
        color: #ff8800;
        background: rgba(255, 136, 0, 0.1);
    }

    .btn-action.tug {
        border-color: rgba(255, 204, 0, 0.4);
        color: #ffcc00;
        background: rgba(255, 204, 0, 0.1);
    }

    .btn-action.colony-btn {
        border-color: rgba(255, 255, 255, 0.6);
        color: #ffffff;
        background: rgba(255, 255, 255, 0.2);
        box-shadow: 0 0 5px rgba(255, 255, 255, 0.3);
    }

    .btn-action:hover {
        background: rgba(255, 255, 255, 0.2);
    }

    .planet-list {
        margin-top: 5px;
        max-height: 150px;
        overflow-y: auto;
    }

    .planet-item {
        background: rgba(68, 136, 255, 0.1);
        border: 1px solid rgba(68, 136, 255, 0.3);
        border-radius: 8px;
        padding: 10px;
        margin-bottom: 6px;
        cursor: pointer;
        transition: all 0.2s;
    }

    .planet-item:hover {
        background: rgba(68, 136, 255, 0.2);
        border-color: #4488ff;
    }

    .btn-action.visit-btn {
        border-color: rgba(0, 255, 204, 0.4);
        color: #00ffcc;
        background: rgba(0, 255, 204, 0.1);
        text-shadow: 0 0 5px rgba(0, 255, 204, 0.3);
    }

    .btn-action.visit-btn:hover {
        background: rgba(0, 255, 204, 0.3);
        box-shadow: 0 0 10px rgba(0, 255, 204, 0.4);
    }
</style>
