@using AstralExpanse.Services
@inject GameStateService GameState

<div class="shipyard-menu @(Show ? "visible" : "")">
    <div class="menu-header">
        <h3>ARK SHIPYARD</h3>
        <button class="btn-close" @onclick="Close">×</button>
    </div>
    
    <div class="ship-options">
        <div class="ship-card" @onclick="() => BuildShip(GameUnitType.MinerUnit, 100)">
            <div class="ship-icon miner-icon"></div>
            <div class="ship-details">
                <span class="ship-title">Venture Miner</span>
                <span class="ship-desc">Automated resource extraction vessel.</span>
                <span class="ship-cost">Cost: 100 Ore</span>
            </div>
            <button class="btn-build @(GameState.Ore < 100 ? "disabled" : "")">BUILD</button>
        </div>

        <div class="ship-card" @onclick="() => BuildShip(GameUnitType.ScoutUnit, 150)">
            <div class="ship-icon scout-icon"></div>
            <div class="ship-details">
                <span class="ship-title">Recon Scout</span>
                <span class="ship-desc">Rapid exploration and resource marking.</span>
                <span class="ship-cost">Cost: 150 Ore</span>
            </div>
            <button class="btn-build @(GameState.Ore < 150 ? "disabled" : "")">BUILD</button>
        </div>

        <div class="ship-card" @onclick="() => BuildShip(GameUnitType.FighterUnit, 250)">
            <div class="ship-icon fighter-icon"></div>
            <div class="ship-details">
                <span class="ship-title">Apex Fighter</span>
                <span class="ship-desc">Tactical defense and sector patrolling.</span>
                <span class="ship-cost">Cost: 250 Ore</span>
            </div>
            <button class="btn-build @(GameState.Ore < 250 ? "disabled" : "")">BUILD</button>
        </div>

        <div class="ship-card" @onclick="() => BuildShip(GameUnitType.TugboatUnit, 300)">
            <div class="ship-icon tugboat-icon"></div>
            <div class="ship-details">
                <span class="ship-title">Titan Tug</span>
                <span class="ship-desc">Heavy-lift vessel for repositioning substations.</span>
                <span class="ship-cost">Cost: 300 Ore</span>
            </div>
            <button class="btn-build @(GameState.Ore < 300 ? "disabled" : "")">BUILD</button>
        </div>

        <div class="ship-card" @onclick="() => BuildShip(GameUnitType.SubStationUnit, 500)">
            <div class="ship-icon substation-icon"></div>
            <div class="ship-details">
                <span class="ship-title">Modular SubStation</span>
                <span class="ship-desc">Deployable hub for remote operations.</span>
                <span class="ship-cost">Cost: 500 Ore</span>
            </div>
            <button class="btn-build @(GameState.Ore < 500 ? "disabled" : "")">BUILD</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public bool Show { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<GameUnitType> OnBuildShip { get; set; }

    private async Task Close() => await OnClose.InvokeAsync();

    private async Task BuildShip(GameUnitType unitType, int cost)
    {
        if (GameState.Ore >= cost)
        {
            await OnBuildShip.InvokeAsync(unitType);
        }
    }
}

<style>
    .shipyard-menu {
        position: fixed;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%) scale(0.9);
        width: 600px;
        background: rgba(10, 20, 30, 0.95);
        border: 2px solid #4488ff;
        border-radius: 8px;
        padding: 20px;
        z-index: 100;
        backdrop-filter: blur(10px);
        box-shadow: 0 0 30px rgba(0, 0, 0, 0.8), inset 0 0 20px rgba(68, 136, 255, 0.2);
        opacity: 0;
        pointer-events: none;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        flex-direction: column;
        color: white;
        font-family: 'Segoe UI', sans-serif;
    }

    .shipyard-menu.visible {
        opacity: 1;
        pointer-events: auto;
        transform: translate(-50%, -50%) scale(1);
    }

    .menu-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid rgba(68, 136, 255, 0.3);
        margin-bottom: 20px;
        padding-bottom: 10px;
    }

    .menu-header h3 {
        margin: 0;
        color: #4488ff;
        letter-spacing: 2px;
        font-weight: bold;
    }

    .btn-close {
        background: none;
        border: none;
        color: #4488ff;
        font-size: 24px;
        cursor: pointer;
        transition: color 0.2s;
    }

    .btn-close:hover {
        color: white;
    }

    .ship-options {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }

    .ship-card {
        display: flex;
        align-items: center;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(68, 136, 255, 0.2);
        border-radius: 6px;
        padding: 12px;
        cursor: pointer;
        transition: all 0.2s;
    }

    .ship-card:hover {
        background: rgba(68, 136, 255, 0.1);
        border-color: #4488ff;
        box-shadow: 0 0 10px rgba(68, 136, 255, 0.2);
    }

    .ship-icon {
        width: 48px;
        height: 48px;
        background: rgba(68, 136, 255, 0.2);
        border-radius: 4px;
        margin-right: 15px;
        position: relative;
    }

    /* Simple icon visuals using gradients/shapes */
    .miner-icon { background: linear-gradient(135deg, #CCAA00 0%, #4488ff 100%); }
    .scout-icon { background: linear-gradient(135deg, #00FF00 0%, #4488ff 100%); }
    .fighter-icon { background: linear-gradient(135deg, #FF3300 0%, #4488ff 100%); }
    .tugboat-icon { background: linear-gradient(135deg, #CC6600 0%, #4488ff 100%); }
    .substation-icon { background: linear-gradient(135deg, #C0C0C0 0%, #4488ff 100%); }

    .ship-details {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .ship-title {
        font-weight: bold;
        color: #ffffff;
        margin-bottom: 4px;
    }

    .ship-desc {
        font-size: 0.85rem;
        color: #aaaaaa;
        margin-bottom: 8px;
    }

    .ship-cost {
        font-size: 0.8rem;
        color: #4488ff;
        font-weight: bold;
    }

    .btn-build {
        background: #4488ff;
        border: none;
        border-radius: 4px;
        color: white;
        padding: 8px 16px;
        font-weight: bold;
        cursor: pointer;
        transition: all 0.2s;
    }

    .btn-build:hover:not(.disabled) {
        background: #66aaff;
        box-shadow: 0 0 10px #4488ff;
    }

    .btn-build.disabled {
        background: #444;
        color: #888;
        cursor: not-allowed;
    }
</style>
