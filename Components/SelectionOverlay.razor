@using AstralExpanse.Services

@if (!string.IsNullOrEmpty(SelectedShipId) || !string.IsNullOrEmpty(SelectedAsteroidId) || !string.IsNullOrEmpty(SelectedStationId))
{
    <div class="selection-info @(SelectedAsteroidId != null ? "asteroid-info" : "")">
        @if (!string.IsNullOrEmpty(SelectedShipId))
        {
            <span>Selected Unit: <span class="ship-id">@SelectedShipId</span></span>
        }
        else if (!string.IsNullOrEmpty(SelectedStationId))
        {
            <span>Selected Station: <span class="ship-id">@SelectedStationId</span></span>
        }
        else if (!string.IsNullOrEmpty(SelectedAsteroidId))
        {
            @if (SelectedAsteroidId.StartsWith("Wormhole"))
            {
                <div class="monolith-selection">
                    <span>Ancient Wormhole Discovered</span>
                    <button class="mine-btn" @onclick="() => OnMineMonolith.InvokeAsync(SelectedAsteroidId)">EXPLORE SYSTEM</button>
                </div>
            }
            else if (SelectedAsteroidId.StartsWith("Monolith"))
            {
                <div class="monolith-selection">
                    <span>Aether Monolith Detected</span>
                    <button class="mine-btn" @onclick="() => OnMineMonolith.InvokeAsync(SelectedAsteroidId)">HARVEST SHARDS (300 ORE)</button>
                </div>
            }
            else
            {
                <span>Target: <strong>@SelectedAsteroidId</strong> | Ore: <span class="ore-stat">@AsteroidOre</span></span>
            }
        }
    </div>
}

@code {
    [Parameter] public string? SelectedShipId { get; set; }
    [Parameter] public string? SelectedAsteroidId { get; set; }
    [Parameter] public string? SelectedStationId { get; set; }
    [Parameter] public int AsteroidOre { get; set; }
    [Parameter] public EventCallback<string> OnMineMonolith { get; set; }
}

<style>
    .selection-info {
        margin-top: 15px;
        font-size: 0.8rem;
        background: rgba(68, 136, 255, 0.2);
        padding: 5px 10px;
        border-radius: 4px;
        display: inline-block;
        border: 1px solid rgba(68, 136, 255, 0.4);
        pointer-events: auto;
    }
    .ship-id { color: #4488ff; font-weight: bold; }
    .asteroid-info { border-color: #ff9900; background: rgba(255, 153, 0, 0.1); }
    .ore-stat { color: #ffcc00; font-weight: bold; }
    .monolith-selection { display: flex; flex-direction: column; align-items: start; gap: 5px; }
    .mine-btn { background: #00ffff; color: #000; border: none; padding: 2px 10px; font-weight: bold; border-radius: 4px; cursor: pointer; font-size: 0.7rem; }
    .mine-btn:hover { background: #88ffff; }
</style>
