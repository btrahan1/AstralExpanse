@if (IsTowingMode || !string.IsNullOrEmpty(TowingTargetId) || !string.IsNullOrEmpty(StationPendingTowId))
{
    <div class="guidance-hud">
        @if (!string.IsNullOrEmpty(StationPendingTowId))
        {
            <span class="success">SELECT DESTINATION ON RADAR</span>
        }
        else if (!string.IsNullOrEmpty(TowingTargetId))
        {
            <span class="warning">SELECT TOWING SHIP (TUGBOAT)</span>
        }
        else
        {
            <span class="warning">SELECT OBJECT TO TOW</span>
        }
    </div>
}

@if (NoTugsAvailable)
{
    <div class="guidance-hud">
        <span class="warning">NO IDLE TUGBOATS AVAILABLE</span>
    </div>
}

@code {
    [Parameter] public bool IsTowingMode { get; set; }
    [Parameter] public string? TowingTargetId { get; set; }
    [Parameter] public string? StationPendingTowId { get; set; }
    [Parameter] public bool NoTugsAvailable { get; set; }
}

<style>
    .guidance-hud {
        margin-top: 15px;
        padding: 10px 15px;
        background: rgba(0, 0, 0, 0.7);
        border: 1px solid #ffcc00;
        border-radius: 4px;
        font-weight: bold;
        letter-spacing: 1px;
        animation: pulse 2s infinite;
    }

    .guidance-hud span.warning { color: #ffcc00; }
    .guidance-hud span.success { color: #00ffcc; border-color: #00ffcc; }

    @@keyframes pulse {
        0% { box-shadow: 0 0 5px rgba(255, 204, 0, 0.3); }
        50% { box-shadow: 0 0 15px rgba(255, 204, 0, 0.6); }
        100% { box-shadow: 0 0 5px rgba(255, 204, 0, 0.3); }
    }
</style>
